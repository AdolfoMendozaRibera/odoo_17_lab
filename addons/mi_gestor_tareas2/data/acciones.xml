<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ========================================= -->
    <!-- SERVER ACTION: Ejecutar código Python -->
    <!-- ========================================= -->
    
    <record id="action_server_completar_tareas" model="ir.actions.server">
        <!-- Server Action: ejecuta código Python en el servidor -->
        
        <field name="name">Completar Tareas Seleccionadas</field>
        <field name="model_id" ref="model_mi_gestor_tareas_tarea"/>
        <!-- ref: referencia al modelo (se genera automáticamente) -->
        
        <field name="binding_model_id" ref="model_mi_gestor_tareas_tarea"/>
        <!-- binding: hace que aparezca en el menú "Acción" de la vista -->
        
        <field name="state">code</field>
        <!-- state="code": ejecutará código Python -->
        
        <field name="code">
# records contiene los registros seleccionados
# self.env es el entorno de Odoo
for record in records:
    record.action_marcar_completada()
        </field>
    </record>
    
    <!-- ========================================= -->
    <!-- SERVER ACTION: Mostrar mensaje -->
    <!-- ========================================= -->
    
    <record id="action_server_mostrar_info" model="ir.actions.server">
        <field name="name">Mostrar Información</field>
        <field name="model_id" ref="model_mi_gestor_tareas_tarea"/>
        <field name="binding_model_id" ref="model_mi_gestor_tareas_tarea"/>
        <field name="state">code</field>
        <field name="code">
# from odoo.exceptions import UserError

# Contar tareas por estado
total = len(records)
completadas = len(records.filtered(lambda r: r.estado == 'completado'))

# Mostrar mensaje
raise UserError(f"Seleccionaste {total} tarea(s). {completadas} completada(s).")
        </field>
    </record>
    
    <!-- ========================================= -->
    <!-- URL ACTION: Abrir enlace externo -->
    <!-- ========================================= -->
    
    <record id="action_url_ayuda" model="ir.actions.act_url">
        <!-- URL Action: abre un enlace web -->
        
        <field name="name">Ver Documentación de Odoo</field>
        <field name="url">https://www.odoo.com/documentation/17.0/</field>
        <field name="target">new</field>
        <!-- target="new": abre en nueva pestaña -->
        <!-- target="self": abre en la misma pestaña -->
    </record>
    
    <!-- Agregar al menú -->
    <menuitem id="menu_ayuda" 
              name="Ayuda / Documentación" 
              parent="menu_gestor_tareas_root" 
              action="action_url_ayuda" 
              sequence="100"/>
    
    <!-- ========================================= -->
    <!-- CRON: Acción programada automática -->
    <!-- ========================================= -->
    
    <record id="cron_limpiar_tareas_vencidas" model="ir.cron">
        <!-- ir.cron: tarea programada que se ejecuta automáticamente -->
        
        <field name="name">Cancelar tareas vencidas</field>
        
        <field name="model_id" ref="model_mi_gestor_tareas_tarea"/>
        
        <field name="state">code</field>
        
        <field name="code">model.limpiar_vencidas()</field>
        <!-- Llama al método limpiar_vencidas() del modelo -->
        
        <field name="interval_number">1</field>
        <!-- Número de intervalos -->
        
        <field name="interval_type">days</field>
        <!-- Tipo de intervalo: minutes, hours, days, weeks, months -->
        
        <field name="numbercall">-1</field>
        <!-- -1 = ejecutar infinitamente, >0 = ejecutar N veces -->
        
        <field name="active" eval="True"/>
        <!-- active: si está activo o no -->
        
        <field name="doall" eval="False"/>
        <!-- Si ejecutar llamadas perdidas al reiniciar -->
    </record>
    
    <!-- ========================================= -->
    <!-- CLIENT ACTION: Acción del cliente web -->
    <!-- ========================================= -->
    
    <record id="action_client_dashboard" model="ir.actions.client">
        <!-- Client Action: acción manejada por el frontend JavaScript -->
        
        <field name="name">Dashboard de Tareas</field>
        <field name="tag">mi_gestor_tareas.dashboard</field>
        <!-- tag: identificador único para el componente JS -->
        <!-- Nota: necesitarías crear el componente JS correspondiente -->
    </record>
    
</odoo>