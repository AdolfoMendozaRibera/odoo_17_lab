<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
        Las vistas en Odoo se definen con <record> dentro de <odoo>
        Cada vista es un registro en la tabla ir.ui.view
    -->
    
    <!-- VISTA TREE (LISTA) -->
    <record id="view_categoria_tree" model="ir.ui.view">
        <!-- id: identificador único de este registro -->
        <!-- model: tabla donde se guarda (siempre ir.ui.view para vistas) -->
        
        <field name="name">mi_gestor_tareas.categoria.tree</field>
        <!-- name: nombre técnico de la vista (debe ser único) -->
        
        <field name="model">mi_gestor_tareas.categoria</field>
        <!-- model: modelo al que aplica esta vista -->
        
        <field name="arch" type="xml">
            <!-- arch: arquitectura de la vista (el HTML/XML de cómo se ve) -->
            
            <tree string="Categorías">
                <!-- tree: vista de lista/tabla -->
                <!-- string: título que aparece en la vista -->
                
                <field name="nombre"/>
                <!-- Cada <field> es una columna en la tabla -->
                
                <field name="descripcion"/>
                <field name="color"/>
                <field name="total_tareas"/>
                <field name="activo"/>
            </tree>
        </field>
    </record>
    
    <!-- VISTA FORM (FORMULARIO) -->
    <record id="view_categoria_form" model="ir.ui.view">
        <field name="name">mi_gestor_tareas.categoria.form</field>
        <field name="model">mi_gestor_tareas.categoria</field>
        <field name="arch" type="xml">
            <form string="Categoría">
                <!-- form: vista de formulario (para crear/editar) -->
                
                <sheet>
                    <!-- sheet: contenedor principal del formulario -->
                    
                    <div class="oe_title">
                        <!-- Sección del título -->
                        <h1>
                            <field name="nombre" placeholder="Ej: Trabajo"/>
                        </h1>
                    </div>
                    
                    <group>
                        <!-- group: agrupa campos en columnas -->
                        <group>
                            <field name="color"/>
                            <field name="activo"/>
                        </group>
                        <group>
                            <field name="total_tareas" readonly="1"/>
                            <!-- readonly="1": campo de solo lectura -->
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- notebook: pestañas -->
                        
                        <page string="Descripción">
                            <!-- page: una pestaña dentro del notebook -->
                            <field name="descripcion"/>
                        </page>
                        
                        <page string="Tareas Asociadas">
                            <!-- Lista inline de tareas -->
                            <field name="tarea_ids">
                                <tree>
                                    <field name="nombre"/>
                                    <field name="estado"/>
                                    <field name="progreso"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- VISTA SEARCH (FILTROS Y BÚSQUEDAS) -->
    <record id="view_categoria_search" model="ir.ui.view">
        <field name="name">mi_gestor_tareas.categoria.search</field>
        <field name="model">mi_gestor_tareas.categoria</field>
        <field name="arch" type="xml">
            <search string="Buscar Categorías">
                <!-- search: vista de búsqueda y filtros -->
                
                <!-- Campo de búsqueda rápida -->
                <field name="nombre"/>
                
                <!-- Filtros predefinidos -->
                <filter string="Activas" name="activas" 
                        domain="[('activo', '=', True)]"/>
                <!-- domain: condición de búsqueda -->
                
                <filter string="Inactivas" name="inactivas" 
                        domain="[('activo', '=', False)]"/>
                
                <separator/>
                
                <!-- Agrupación -->
                <group expand="0" string="Agrupar Por">
                    <filter string="Color" name="group_color" 
                            context="{'group_by': 'color'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- ACCIÓN DE VENTANA -->
    <record id="action_categoria" model="ir.actions.act_window">
        <!-- act_window: acción que abre vistas -->
        
        <field name="name">Categorías</field>
        <!-- Nombre que aparece en el menú y en la ventana -->
        
        <field name="res_model">mi_gestor_tareas.categoria</field>
        <!-- Modelo que se abrirá -->
        
        <field name="view_mode">tree,form</field>
        <!-- Modos de vista disponibles (en orden) -->
        
        <field name="help" type="html">
            <!-- Mensaje de ayuda cuando no hay registros -->
            <p class="o_view_nocontent_smiling_face">
                Crea tu primera categoría
            </p>
            <p>
                Las categorías te ayudan a organizar tus tareas.
            </p>
        </field>
    </record>
    
    <!-- MENÚ -->
    <menuitem id="menu_gestor_tareas_root" 
              name="Gestor de Tareas" 
              sequence="10"/>
    <!-- Menú raíz (aparece en la barra superior) -->
    
    <menuitem id="menu_categoria" 
              name="Categorías" 
              parent="menu_gestor_tareas_root" 
              action="action_categoria" 
              sequence="20"/>
    <!-- Submenú que abre la acción -->
    
</odoo>