<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!--   TEMPLATE HEREDADO DEL REPORTE ORIGINAL DE COTIZACIÓN   -->
        <!-- ========================================================= -->

        <template id="report_jah_saleorder_document" inherit_id="sale.report_saleorder_document">

            <xpath expr="//div[@id='informations']" position="replace">
                <div id="informations" class="row mt-2 mb-4">
                    <div t-if="doc.validity_date and doc.state in ['draft', 'sent']" class="col-auto col-3 mw-100 mb-2">
                        <strong>Validez hasta:</strong><br/>
                        <span class="m-0" t-field="doc.validity_date"/>
                    </div>
                    <div t-if="doc.user_id.name" class="col-auto col-3 mw-100 mb-2">
                        <strong>Vendedor:</strong><br/>
                        <span class="m-0" t-field="doc.user_id.name"/>
                    </div>
                </div>
            </xpath>

            <!-- ========================================================= -->
            <!-- SECCIÓN 2: MODIFICAR ENCABEZADO DE LA TABLA DE PRODUCTOS  -->
            <!-- - Se agregan columnas solicitadas                         -->
            <!-- - Se mantiene estilo nativo                               -->
            <!-- ========================================================= -->

            <!-- Columna: Código del producto (antes de descripción) -->
            <xpath expr="//th[@name='th_description']" position="before">
                <th name="th_code" class="text-start" style="width: 10%;">
                    Código
                </th>
            </xpath>

            <!-- Columna: Unidad (después de código) -->
            <xpath expr="//th[@name='th_code']" position="after">
                <th name="th_unit" class="text-center" style="width: 8%;">
                    Unidad
                </th>
            </xpath>

            <!-- Columna: Descuento (DESACTIVADO TEMPORALMENTE)
            - Se comenta para evitar errores en caso de permisos o grupos
            - IMPORTANTE: Debes activarlo cuando confirmes que funciona en PDF
            -->
            <!--
            <xpath expr="//th[@name='th_priceunit']" position="after">
                <th name="th_discount" class="text-end" style="width: 8%;">
                    <span groups="product.group_discount_per_so_line">Desc.%</span>
                </th>
            </xpath>
            -->

            <!-- Cambiar título del subtotal -->
            <xpath expr="//th[@name='th_subtotal']/span" position="replace">
                <span>Sub Total</span>
            </xpath>

            <!-- ========================================================= -->
            <!-- SECCIÓN 3: AGREGAR CAMPOS A CADA LÍNEA DE PRODUCTO        -->
            <!-- ========================================================= -->

            <!-- Código del producto -->
            <xpath expr="//td[@name='td_name']" position="before">
                <td name="td_code" class="text-start">
                    <t t-if="line.product_id">
                        <span t-field="line.product_id.default_code" 
                              t-att-title="line.product_id.default_code or 'Sin código'"/>
                    </t>
                    <t t-else="">
                        <span title="Producto no especificado">-</span>
                    </t>
                </td>
            </xpath>

            <!-- Unidad del producto -->
            <xpath expr="//td[@name='td_code']" position="after">
                <td name="td_unit" class="text-center">
                    <t t-if="line.product_uom">
                        <span t-field="line.product_uom" 
                              t-att-title="line.product_uom.name or ''"/>
                    </t>
                    <t t-else="">
                        <span title="Unidad no especificada">-</span>
                    </t>
                </td>
            </xpath>

            <!-- Descuento en la línea (DESACTIVADO TEMPORALMENTE)
            - Mismo motivo que el encabezado
            -->
            
            <!-- 
            <xpath expr="//td[@name='td_priceunit']" position="after">
                <td name="td_discount" class="text-end">
                    <span groups="product.group_discount_per_so_line" t-if="line.discount">
                        <t t-out="line.discount"/>%
                    </span>
                </td>
            </xpath>

            -->
            

            <!-- ========================================================= -->
            <!-- SECCIÓN 4: AJUSTE DE COLSPAN PARA LÍNEAS ESPECIALES       -->
            <!-- - Asegura que líneas de sección, notas y subtotales       -->
            <!--   ocupen el ancho correcto luego de agregar columnas      -->
            <!-- ========================================================= -->

            <xpath expr="//td[@name='td_section_line']" position="attributes">
                <attribute name="colspan">8</attribute>
            </xpath>

            <xpath expr="//td[@name='td_note_line']" position="attributes">
                <attribute name="colspan">8</attribute>
            </xpath>

            <xpath expr="//td[@name='td_section_subtotal']" position="attributes">
                <attribute name="colspan">8</attribute>
            </xpath>

            <!-- ========================================================= -->
            <!-- SECCIÓN 5: AGREGAR BLOQUES DE FIRMA                      -->
            <!-- - Se muestran según estado del documento                  -->
            <!--   * draft/sent → mensaje informativo                      -->
            <!--   * sale/done → área de firma del cliente                 -->
            <!-- ========================================================= -->

            <xpath expr="//div[contains(@class, 'page')]" position="inside">

                <!-- Sección visible SOLO en órdenes confirmadas -->
                <div>
                    <t t-if="doc.state in ['sale', 'done']">
                        <div class="row jah-signature-section" style="page-break-inside: avoid; margin-top: auto; padding-top: 100px;">
                            <div class="col-12 mx-auto jah-signature-container" style="max-width: 400px;">
                                <div class="jah-signature-line" style="border-top: 2px solid black; padding-top: 10px;">
                                    <p class="jah-signature-title" style="margin: 0; font-weight: bold; text-align: center;">
                                        FIRMA DE APROBACIÓN
                                    </p>
                                    <p class="jah-signature-note" style="margin-top: 10px; font-size: 9pt; color: #666; text-align: center;">
                                        *Esta firma autoriza la ejecución de la orden de venta*
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
                
                <!-- Sección visible SOLO en cotizaciones -->
                <t t-if="doc.state in ['draft', 'sent']">
                    <div class="row mt-3">
                        <div class="col-12 text-center">
                            <p style="font-style: italic; color: #666; font-size: 10pt;">
                                Esta cotización requiere aprobación para convertirse en orden de venta.
                            </p>
                        </div>
                    </div>
                </t>

            </xpath>

            <xpath expr="//div[@id='total']" position="replace">
                <div id="total" class="row" name="total">
                    <div class="col-4 ms-auto">
                        <table class="table table-sm table-borderless">
                            <t t-if="doc.state in ['draft', 'sent']">
                                <tr class="border-black">
                                    <td><strong>Subtotal</strong></td>
                                    <td class="text-end"><span t-field="doc.amount_untaxed"/></td>
                                </tr>
                                <tr class="border-black o_total">
                                    <td><strong>Total</strong></td>
                                    <td class="text-end"><strong><span t-field="doc.amount_total"/></strong></td>
                                </tr>
                            </t>

                            <t t-else="">
                                <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                <t t-call="sale.document_tax_totals"/>
                            </t>
                        </table>
                    </div>
                </div>
            </xpath>

            

        </template>
    </data>
</odoo>