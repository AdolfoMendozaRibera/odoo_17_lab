<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_jah_stock_document"
                  inherit_id="stock.report_delivery_document">

            <!-- ========================= -->
            <!-- 1. ENCABEZADO -->
            <!-- ========================= -->
            <xpath expr="//h2[span[@t-field='o.name']]" position="replace">
                <h2>
                    <span t-if="o.picking_type_id.code == 'outgoing'">NOTA DE ENTREGA</span>
                    <span t-elif="o.picking_type_id.code == 'incoming'">RECEPCIÓN DE MATERIALES</span>
                    <span t-else="">TRANSFERENCIA INTERNA</span>
                    <br/>
                    <span t-field="o.name"/>
                </h2>
            </xpath>

            <!-- ========================= -->
            <!-- 2. DATOS CLIENTE / PROVEEDOR -->
            <!-- ========================= -->
            <xpath expr="//div[contains(@class, 'report-wrapping-flexbox')]" position="replace">
                <div class="row mb-4">
                    <div t-if="partner" class="col-6">
                        <h5>
                            <span t-if="o.picking_type_id.code == 'outgoing'">Datos del Cliente</span>
                            <span t-elif="o.picking_type_id.code == 'incoming'">Datos del Proveedor</span>
                        </h5>

                        <p class="mb-1"><strong>Nombre/Razón Social:</strong></p>
                        <p class="mb-2" t-field="partner.name"/>

                        <p class="mb-1" t-if="partner.vat"><strong>NIT:</strong></p>
                        <p class="mb-2" t-if="partner.vat" t-field="partner.vat"/>

                        <p class="mb-1"><strong>Dirección:</strong></p>
                        <!-- SOLUCIÓN: Mostrar dirección manualmente -->
                        <p class="mb-2">
                            <span t-field="partner.street"/>
                            <t t-if="partner.street2">
                                <br/><span t-field="partner.street2"/>
                            </t>
                            <t t-if="partner.city">
                                <br/><span t-field="partner.city"/>
                            </t>
                            <t t-if="partner.state_id">
                                <br/><span t-field="partner.state_id.name"/>
                            </t>
                            <t t-if="partner.country_id">
                                <br/><span t-field="partner.country_id.name"/>
                            </t>
                        </p>
                    </div>

                    <div t-att-class="'col-6' if partner else 'col-12'">
                        <h5>Información de la Operación</h5>

                        <p class="mb-1"><strong>Referencia:</strong></p>
                        <p class="mb-2" t-field="o.name"/>

                        <p class="mb-1"><strong>Fecha:</strong></p>
                        <p class="mb-2">
                            <span t-if="o.state == 'done'" t-field="o.date_done" t-options='{"widget": "date"}'/>
                            <span t-else="" t-field="o.scheduled_date" t-options='{"widget": "date"}'/>
                        </p>

                        <p class="mb-1" t-if="o.origin"><strong>Origen:</strong></p>
                        <p class="mb-2" t-if="o.origin" t-field="o.origin"/>
                    </div>
                </div>
            </xpath>

            <!-- ========================= -->
            <!-- 3. TABLA PENDIENTE -->
            <!-- ========================= -->
            <xpath expr="//table[@name='stock_move_table']" position="replace">
                <table class="table table-sm table-bordered" t-if="o.state != 'done'" name="stock_move_table">
                    <thead style="background-color: #f8f9fa;">
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th style="text-align:center;">Unidad</th>
                            <th style="text-align:center;">Ordenado</th>
                            <th style="text-align:center;">Entregado</th>
                            <th style="text-align:center;">Diferencia</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                        <tr t-foreach="lines" t-as="move">

                            <td><span t-field="move.product_id.default_code"/></td>

                            <td>
                                <span t-field="move.product_id"/>
                                <p t-if="move.description_picking and move.description_picking != move.product_id.name"
                                   class="mb-0 text-muted small">
                                    <span t-field="move.description_picking"/>
                                </p>
                            </td>

                            <td style="text-align:center;"><span t-field="move.product_uom"/></td>
                            <td style="text-align:center;"><span t-field="move.product_uom_qty"/></td>
                            <td style="text-align:center; font-weight:bold;"><span t-field="move.quantity"/></td>

                            <td style="text-align:center;">
                                <t t-set="diff" t-value="move.quantity - move.product_uom_qty"/>
                                <span t-esc="diff"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </xpath>

            <!-- ========================= -->
            <!-- 4. TABLA COMPLETADO -->
            <!-- ========================= -->
            <xpath expr="//table[@name='stock_move_line_table']" position="replace">
                <table class="table table-sm table-bordered mt-4" 
                       t-if="o.move_line_ids and o.state == 'done'" 
                       name="stock_move_line_table">
                    <thead style="background-color: #f8f9fa;">
                        <tr>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th style="text-align:center;">Unidad</th>
                            <th style="text-align:center;">Ordenado</th>
                            <th style="text-align:center;">Entregado</th>
                            <th style="text-align:center;">Diferencia</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="agg" t-value="o.move_line_ids._get_aggregated_product_quantities()"/>

                        <tr t-foreach="agg" t-as="k">
                            <td>
                                <span t-esc="k[0].default_code or ''"/>
                            </td>

                            <td>
                                <span t-esc="agg[k]['name']"/>
                                <p t-if="agg[k]['description']" class="mb-0 text-muted small">
                                    <span t-esc="agg[k]['description']"/>
                                </p>
                            </td>

                            <td style="text-align:center;"><span t-esc="agg[k]['product_uom'].name"/></td>

                            <td style="text-align:center;">
                                <span t-esc="agg[k]['qty_ordered']"/>
                            </td>

                            <td style="text-align:center; font-weight:bold;">
                                <span t-esc="agg[k]['quantity']"/>
                            </td>

                            <td style="text-align:center;">
                                <t t-set="diff" t-value="agg[k]['quantity'] - agg[k]['qty_ordered']"/>
                                <span t-esc="diff"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </xpath>

            <!-- ========================= -->
            <!-- 5. FIRMAS -->
            <!-- ========================= -->
            <xpath expr="//div[@class='page']/div[@class='oe_structure'][last()]" position="after">
                <div class="signatures mt-5 pt-4" style="border-top: 2px solid #dee2e6; page-break-inside: avoid;">
                    <div class="row">

                        <!-- RESPONSABLE -->
                        <div class="col-6">
                            <div style="margin-top:50px; border-bottom:2px solid black; width:80%;"></div>
                            <p class="mt-2 mb-1"><strong>Responsable de Entrega/Recepción</strong></p>
                            <p class="mb-0" style="font-size: 9pt;">Nombre: _______________________________</p>
                            <p class="mb-0" style="font-size: 9pt;">Cargo: _______________________________</p>
                        </div>

                        <!-- CLIENTE / PROVEEDOR -->
                        <div class="col-6">
                            <div style="margin-top:50px; border-bottom:2px solid black; width:80%;"></div>
                            <p class="mt-2 mb-1">
                                <strong>
                                    <span t-if="o.picking_type_id.code == 'outgoing'">Cliente que Recibe</span>
                                    <span t-elif="o.picking_type_id.code == 'incoming'">Proveedor que Entrega</span>
                                    <span t-else="">Responsable que Recibe</span>
                                </strong>
                            </p>
                            <p class="mb-0" style="font-size: 9pt;">Nombre: _______________________________</p>
                            <p class="mb-0" style="font-size: 9pt;">CI/NIT: _______________________________</p>
                        </div>

                    </div>

                    <!-- OBSERVACIONES -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <p class="mb-2"><strong>Observaciones:</strong></p>
                            <div style="min-height: 60px; border: 1px solid #dee2e6; padding: 10px; background-color: #f8f9fa;">
                                <span t-if="o.note" t-field="o.note"/>
                                <span t-else="" style="color: #999;">Sin observaciones adicionales</span>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </template>
    </data>
</odoo>