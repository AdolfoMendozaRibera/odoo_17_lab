<odoo>
    <template id="jah_external_layout_standard_fix" inherit_id="web.external_layout_standard">
        
        <xpath expr="//div[contains(@t-attf-class, 'header')]" position="replace">
            
            <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                
                <t t-set="company" t-value="o.company_id or company"/> 
                
                <div class="jah-header" 
                     style="min-height:3cm; max-height:3cm; overflow:hidden; border-bottom:1px solid #000; padding:6px 0;">
                    
                    <div class="d-flex" style="display:flex; width:100%;">

                        <div style="width:25%; text-align:center;">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                style="max-height:2.5cm; max-width:100%; object-fit:contain; margin: auto;"/>
                        </div>

                        <div style="width:75%; text-align:left; padding-left:10px; line-height: 1.2;">
                            <p style="font-size:14px; font-weight:bold; margin:0;"><t t-esc="company.name"/></p>
                            <p style="font-size:12px; margin:0; font-weight:bold; color: #555;">Casa Matriz</p> 
                            <p style="font-size:12px; margin:0;">
                                <t t-esc="company.street or ''"/> 
                                <t t-if="company.street2">, <t t-esc="company.street2"/></t><br/>
                                <t t-esc="company.city or ''"/> 
                                <t t-if="company.state_id">, <t t-esc="company.state_id.name"/></t>
                            </p>
                            <p style="font-size:12px; margin:0;">
                                Teléfono: <t t-esc="company.phone or '-'"/>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            
        </xpath>
    </template>
</odoo>