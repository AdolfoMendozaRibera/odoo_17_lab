<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!--  TEMPLATE PERSONALIZADO PARA COMPROBANTE DE PAGO         -->
        <!--  Hereda del template nativo de Odoo                      -->
        <!-- ========================================================= -->
        <!-- 
        OBJETIVO: Personalizar el reporte de comprobante de pago de Odoo
        HEREDADO DE: account.report_payment_receipt_document (reporte nativo)
        RELEVANCIA: Cumple con HU-CP-01 y HU-CP-02
        IMPORTANTE: No modifica la lógica contable, solo la presentación
        -->

        <template id="report_jah_payment_receipt_document" 
                 inherit_id="account.report_payment_receipt_document">

            <!-- ========================================================= -->
            <!-- SECCIÓN 1: CAMBIAR EL TÍTULO DEL COMPROBANTE             -->
            <!-- ========================================================= -->
            <!-- 
            REQUERIMIENTO: "Cambiar título automático por 'Recibo de Pago' / 'Recibo de Ingreso'"
            OBJETIVO: Mostrar títulos más descriptivos según el tipo de pago
            LÓGICA: 
            - customer → Recibo de Ingreso (entrada de dinero)
            - supplier → Recibo de Pago (salida de dinero)
            - otros → Comprobante de Pago genérico
            -->
            <xpath expr="//div[@class='page']/h3[1]" position="replace">
                <h3 class="mt-4 mb-4">
                    <strong id="payment_title">
                        <!-- Título dinámico según tipo de partner -->
                        <span t-if="o.partner_type == 'customer'">INCOME RECEIPT</span>
                        <span t-elif="o.partner_type == 'supplier'">PAYMENT RECEIPT</span>
                        <span t-else="">PAYMENT VOUCHER</span>
                        <!-- Mantiene el número/nombre del comprobante -->
                        : <span t-field="o.name"/>
                    </strong>
                </h3>
            </xpath>

            <!-- ========================================================= -->
            <!-- SECCIÓN 2: MOSTRAR USUARIO QUE REGISTRA EL PAGO          -->
            <!-- ========================================================= -->
            <!-- 
            REQUERIMIENTO: HU-CP-02 - Visualizar datos del usuario
            OBJETIVO: Mostrar nombre y cargo del usuario que creó el pago
            DATOS:
            - o.create_uid: Usuario que creó el registro
            - o.create_uid.function: Campo 'Cargo' del usuario en Odoo
            -->
            <xpath expr="//div[@name='date']" position="before">
                <div class="row">
                    <!-- Columna 1: Nombre del usuario -->
                    <div class="col-6">
                        <strong>Registered by:</strong><br/>
                        <span t-field="o.create_uid.name" t-if="o.create_uid"/>
                        <span t-else="" style="color: #999;">Not specified</span>
                    </div>

                    <!-- Columna 2: Cargo del usuario -->
                    <div class="col-6">
                        <strong>Position:</strong><br/>
                        <!-- o.create_uid.function es el campo 'Cargo' en res.users -->
                        <span t-if="o.create_uid and o.create_uid.function" t-field="o.create_uid.function"/>
                        <span t-else="" style="color: #999;">Not specified</span>
                    </div>
                </div>
            </xpath>


            <!-- ========================================================= -->
            <!-- SECCIÓN 3: FIRMAS                                         -->
            <!-- ========================================================= -->
            <!-- 
            REQUERIMIENTO: HU-CP-01 - Firmas en comprobante
            OBJETIVO: Agregar 3 líneas de firma para respaldo físico
            FIRMAS:
            1. Cliente/Proveedor (quien paga/recibe)
            2. Usuario/Cajero (quien registra)
            3. Recibido por (para completar manualmente)
            NOTA: Se agrega al final del documento existente
            -->
            <xpath expr="//div[@class='page']" position="inside">

                <!-- Contenedor principal de firmas -->
                <div class="signatures mt-5 pt-4"
                     style="margin-top: 100px !important; margin-bottom: 40px; border-top: 10px solid #ffffffff; page-break-inside: avoid;">
                     <!-- 
                     ESTILOS IMPORTANTES:
                     - margin-top: 100px → Separa firmas del contenido anterior
                     - border-top transparente → Espacio visual sin línea visible
                     - page-break-inside: avoid → Evita que se corte entre páginas
                     -->

                    <div class="row d-flex justify-content-between">

                        <!-- 
                        FIRMA 1: CLIENTE O PROVEEDOR
                        ==========================
                        Título dinámico según partner_type
                        Muestra datos del contacto para referencia
                        -->
                        <div class="col-4">
                            <!-- Línea de firma (borde inferior) -->
                            <div style="margin-top: 50px; border-bottom: 2px solid black; width: 90%;"></div>

                            <p class="mt-2 mb-1">
                                <strong>
                                    <span t-if="o.partner_type == 'customer'">Customer Signature</span>
                                    <span t-elif="o.partner_type == 'supplier'">Supplier Signature</span>
                                    <span t-else="">Contact Signature</span>
                                </strong>
                            </p>

                            <!-- Datos informativos pre-llenados -->
                            <p class="mb-0" style="font-size: 9pt;">
                                Name: 
                                <span t-if="o.partner_id" t-field="o.partner_id.name"/>
                                <span t-else="">_________________</span>
                            </p>

                            <p class="mb-0" style="font-size: 9pt;">
                                ID/Tax ID: 
                                <span t-if="o.partner_id and o.partner_id.vat" t-field="o.partner_id.vat"/>
                                <span t-else="">_________________</span>
                            </p>
                        </div>

                        <!-- 
                        FIRMA 2: USUARIO/CAJERO
                        ==========================
                        REQUERIMIENTO: HU-CP-02 - Mostrar nombre y cargo del usuario
                        Muestra datos del usuario que creó el registro
                        -->
                        <div class="col-4">
                            <!-- Línea de firma -->
                            <div style="margin-top: 50px; border-bottom: 2px solid black; width: 90%;"></div>

                            <p class="mt-2 mb-1"><strong>User Signature (Cashier)</strong></p>

                            <!-- Nombre del usuario -->
                            <p class="mb-0" style="font-size: 9pt;">
                                Name: 
                                <span t-if="o.create_uid" t-field="o.create_uid.name"/>
                                <span t-else="">_________________</span>
                            </p>

                            <!-- Cargo del usuario -->
                            <p class="mb-0" style="font-size: 9pt;">
                                Position:
                                <span t-if="o.create_uid and o.create_uid.function" t-field="o.create_uid.function"/>
                                <span t-else="">_________________</span>
                            </p>
                        </div>

                        <!-- 
                        FIRMA 3: RECIBIDO POR (MANUAL)
                        ==========================
                        Espacio para completar manualmente cuando se entrega/recibe físicamente
                        No tiene datos automáticos - se completa a mano
                        -->
                        <div class="col-4">
                            <!-- Línea de firma -->
                            <div style="margin-top: 50px; border-bottom: 2px solid black; width: 90%;"></div>

                            <p class="mt-2 mb-1">
                                <strong>Received by (Name and ID)</strong>
                            </p>

                            <!-- Campos para completar manualmente -->
                            <p class="mb-0" style="font-size: 9pt;">Name: _______________________</p>
                            <p class="mb-0" style="font-size: 9pt;">ID: _________________</p>
                        </div>

                    </div>

                    <!-- ========================================================= -->
                    <!-- SECCIÓN 4: OBSERVACIONES (COMENTADA - OPCIONAL)          -->
                    <!-- ========================================================= -->
                    <!-- 
                    SECCIÓN OPCIONAL: Puede activarse si se requiere área de observaciones
                    ACTUALMENTE: Comentada para simplificar el documento
                    PROPÓSITO: Área para notas manuales adicionales
                    -->
                    <!--
                    <div class="row mt-4">
                        <div class="col-12">
                            <p class="mb-2"><strong>Observaciones:</strong></p>
                            <div style="min-height: 50px; border: 1px solid #dee2e6; 
                                      padding: 10px; background-color: #f8f9fa;">
                                <span t-if="o.ref" t-field="o.ref"/>
                                <span t-else="" style="color: #999;">Sin observaciones adicionales</span>
                            </div>
                        </div>
                    </div>
                    -->

                </div>
            </xpath>

        </template>
    </data>
</odoo>