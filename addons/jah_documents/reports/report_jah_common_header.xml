<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!-- TEMPLATE BASE – ENCABEZADO ESTÁNDAR PARA JAH               -->
        <!-- ========================================================= -->
        <template id="report_jah_common_header">
            <t t-call="web.external_layout">
                <div class="jah-header" style="height:3cm; border-bottom:1px solid #000; padding:6px 0;">
                    <div class="d-flex" style="display:flex; width:100%; height:100%;">

                        <!-- LOGO -->
                        <div style="width:25%; text-align:center;">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                                 style="max-height:2.5cm; max-width:100%; object-fit:contain;"/>
                        </div>

                        <!-- DATOS EMPRESA -->
                        <div style="width:75%; text-align:left; padding-left:10px;">

                            <p style="font-size:14px; font-weight:bold; margin:0;">
                                <t t-esc="company.name"/>
                            </p>

                            <p style="font-size:12px; margin:0;">
                                <t t-esc="company.street or ''"/> 
                                <t t-if="company.street2">, <t t-esc="company.street2"/></t><br/>
                                <t t-esc="company.city or ''"/> 
                                <t t-if="company.state_id">, <t t-esc="company.state_id.name"/></t>
                            </p>

                            <p style="font-size:12px; margin:0;">
                                Teléfono: <t t-esc="company.phone or '-'"/>
                            </p>

                            <p style="font-size:12px; margin:0;">
                                Casa Matriz
                            </p>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>
