<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_jah_common_footer" inherit_id="web.external_layout_standard">
        <xpath expr="//div[contains(@t-attf-class, 'footer')]" position="replace">
            
            <!-- NUEVO FOOTER CORPORATIVO JAH -->
            <div class="footer o_standard_footer jah-footer"
                 t-attf-class="footer o_standard_footer o_company_#{company.id}_layout jah-footer"
                 t-att-style="report_footer_style">
                
                <t t-set="company" t-value="o.company_id or company"/>
                
                <!-- Footer corporativo JAH: se muestra en documentos de ventas y entregas -->
                <t t-if="o and not (o._name == 'account.payment' or (o._name == 'account.move' and o.move_type == 'entry'))">
                    <div class="text-center jah-footer-container">
                        
                        <!-- Texto personalizado JAH -->
                        <div class="jah-footer-content">
                            <p class="jah-footer-line jah-footer-main">
                                <strong>JAH - Soluciones y Logística.</strong> Su socio de confianza para el crecimiento de su negocio.
                            </p>
                            <p class="jah-footer-line jah-footer-secondary">
                                Para cualquier consulta, póngase en contacto con nuestra oficina central.
                            </p>
                        </div>

                        <!-- Numeración de páginas en PDF -->
                        <div t-if="report_type == 'pdf'" class="jah-footer-meta jah-page-info">
                            Página: <span class="page"/> / <span class="topage"/>
                        </div>
                        
                        <!-- Nombre del documento si está configurado -->
                        <div t-if="report_type == 'pdf' and display_name_in_footer" 
                             class="jah-footer-meta jah-doc-name">
                            <span t-out="o.name"/>
                        </div>
                    </div>
                </t>
                
                <!-- Footer original solo para comprobantes contables y pagos -->
                <t t-if="o and (o._name == 'account.payment' or (o._name == 'account.move' and o.move_type == 'entry'))">
                    <div class="text-center account-footer-container">
                        <ul class="list-inline mb-4">
                            <div t-field="company.report_footer"/>
                        </ul>
                        <div t-if="report_type == 'pdf'" class="text-muted">
                            Page: <span class="page"/> / <span class="topage"/>
                        </div>
                        <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">
                            <span t-out="o.name"/>
                        </div>
                    </div>
                </t>
                
            </div>
        </xpath>
    </template>
</odoo>
