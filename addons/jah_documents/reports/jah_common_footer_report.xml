<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
    PLANTILLA DE PIE DE PÁGINA ESTÁNDAR PARA JAH
    =============================================
    Esta plantilla reemplaza el pie de página estándar de Odoo con un diseño personalizado
    que cumple con los requerimientos del brief:
    - Footer corporativo para documentos de ventas
    - Footer contable estándar para comprobantes contables
    -->
    <template id="report_jah_common_footer" inherit_id="web.external_layout_standard">
        
        <!-- 
        REEMPLAZO DEL FOOTER ORIGINAL
        ==============================
        Buscamos el div principal que contiene el footer en Odoo y lo reemplazamos
        completamente con nuestra estructura personalizada.
        -->
        <xpath expr="//div[contains(@t-attf-class, 'footer')]" position="replace">
            
            <!-- 
            CONTENEDOR PRINCIPAL DEL FOOTER
            ================================
            - Clases CSS específicas para JAH
            - Se incluye dinámicamente el ID de la compañía en las clases
            - t-att-style aplica estilos CSS desde el reporte
            -->
            <div class="footer o_standard_footer jah-footer"
                 t-attf-class="footer o_standard_footer o_company_#{company.id}_layout jah-footer"
                 t-att-style="report_footer_style">
                
                <!-- 
                VARIABLES DE CONTEXTO
                ======================
                Estas variables determinan el comportamiento del footer según el tipo de documento
                -->
                <t t-set="company" t-value="o and o.company_id or company"/>
                
                <!-- 
                DETECCIÓN DE DOCUMENTOS CONTABLES
                Identifica si es un documento contable según el brief:
                - account.payment: Comprobante de pago
                - account.move con tipo 'entry': Asiento contable
                Estos documentos NO deben tener el footer corporativo de JAH
                -->
                <t t-set="is_accounting_document" 
                   t-value="o and (o._name == 'account.payment' or (o._name == 'account.move' and o.move_type == 'entry'))"/>
                
                <!-- 
                CASO 1: DOCUMENTOS CONTABLES (PAGOS Y ASIENTOS)
                ================================================
                Según el brief: "NO debe aplicarse al comprobante contable"
                Mantiene el footer estándar de Odoo para estos documentos
                -->
                <t t-if="is_accounting_document">
                    <div class="text-center account-footer-container">
                        <!-- 
                        FOOTER ESTÁNDAR DE ODOO
                        Usa el footer configurado en la empresa en Odoo
                        Esto cumple con: "Mantener el comprobante contable tal como Odoo lo genera"
                        -->
                        <ul class="list-inline mb-4">
                            <t t-if="company and company.report_footer">
                                <div t-field="company.report_footer"/>
                            </t>
                            <t t-else="">
                                <div>Company footer not configured</div>
                            </t>
                        </ul>
                        
                        <!-- NUMERACIÓN DE PÁGINAS (solo PDF) -->
                        <t t-if="report_type == 'pdf'">
                            <div class="text-muted">
                                <!-- 
                                VARIABLES ESPECIALES DE QWEB:
                                - page: número de página actual
                                - topage: total de páginas
                                Estas variables son automáticas en Odoo para PDF
                                -->
                                Page: <span class="page"/> / <span class="topage"/>
                            </div>
                        </t>
                        
                        <!-- NOMBRE DEL DOCUMENTO (si está configurado) -->
                        <div t-if="report_type == 'pdf' and display_name_in_footer and o.name" 
                             class="text-muted">
                            <span t-out="o.name"/>
                        </div>
                    </div>
                </t>
                
                <!-- 
                CASO 2: FOOTER CORPORATIVO JAH PARA OTROS DOCUMENTOS
                =====================================================
                Aplica a: Factura, Cotización, Orden de Venta, Nota de Entrega
                Según el brief: "Pie de página estándar (solo en documentos de ventas)"
                -->
                <t t-elif="o">
                    <div class="text-center jah-footer-container">
                        
                        <!-- 
                        TEXTO CORPORATIVO PERSONALIZADO JAH
                        Contenido fijo según requerimientos del cliente
                        "Texto de JAH (proveer contenido final)"
                        -->
                        <div class="jah-footer-content">
                            <p class="jah-footer-line jah-footer-main">
                                <strong>JAH - Solutions and Logistics.</strong> 
                                Your trusted partner for business growth.
                            </p>
                            <p class="jah-footer-line jah-footer-secondary">
                                For any inquiries, please contact our headquarters.
                            </p>
                        </div>

                        <!-- 
                        INFORMACIÓN DE CONTACTO OPCIONAL
                        Muestra datos de contacto de la empresa si están disponibles
                        No es obligatorio según el brief, pero es un valor agregado
                        -->
                        <t t-if="company and company.email">
                            <p class="jah-footer-line jah-footer-contact">
                                Contact: <span t-esc="company.email"/>
                                <t t-if="company.phone"> | Tel: <span t-esc="company.phone"/></t>
                            </p>
                        </t>

                        <!-- 
                        NUMERACIÓN DE PÁGINAS EN PDF
                        Solo se muestra cuando el reporte es generado como PDF
                        report_type puede ser: 'pdf', 'html', 'text', etc.
                        -->
                        <t t-if="report_type == 'pdf'">
                            <div class="jah-footer-meta jah-page-info">
                                Page: <span class="page"/> / <span class="topage"/>
                            </div>
                        </t>
                        
                        <!-- 
                        NOMBRE DEL DOCUMENTO (OPCIONAL)
                        Solo se muestra si:
                        1. Es PDF
                        2. display_name_in_footer está configurado como True
                        3. El documento tiene nombre (o.name)
                        -->
                        <t t-if="report_type == 'pdf' and display_name_in_footer and o.name">
                            <div class="jah-footer-meta jah-doc-name">
                                <span t-out="o.name"/>
                            </div>
                        </t>
                    </div>
                </t>
                
                <!-- 
                CASO 3: FALLBACK - CUANDO NO HAY OBJETO 'o'
                ============================================
                Caso de precaución para cuando no hay documento principal
                Esto puede ocurrir en reportes especiales o en situaciones de error
                -->
                <t t-else="">
                    <div class="text-center default-footer-container">
                        <!-- FOOTER ESTÁNDAR DE LA EMPRESA -->
                        <div t-if="company and company.report_footer">
                            <div t-field="company.report_footer"/>
                        </div>
                        
                        <!-- NUMERACIÓN DE PÁGINAS EN PDF -->
                        <t t-if="report_type == 'pdf'">
                            <div class="text-muted">
                                Page: <span class="page"/> / <span class="topage"/>
                            </div>
                        </t>
                    </div>
                </t>
                
            </div>
        </xpath>
    </template>
</odoo>