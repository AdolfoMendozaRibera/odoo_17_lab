<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 
    PLANTILLA DE ENCABEZADO ESTÁNDAR PARA JAH
    =========================================
    Esta plantilla reemplaza el encabezado estándar de Odoo con un diseño personalizado
    que cumple con los requerimientos del cliente JAH.
    
    Hereda del layout estándar de Odoo para garantizar compatibilidad.
    -->
    <template id="report_jah_common_header" inherit_id="web.external_layout_standard">

        <!-- 
        REEMPLAZO DEL ENCABEZADO ORIGINAL
        =================================
        Buscamos el div principal que contiene el encabezado en Odoo y lo reemplazamos
        completamente con nuestra estructura personalizada.
        -->
        <xpath expr="//div[contains(@t-attf-class, 'header')]" position="replace">

            <!-- 
            CONTENEDOR PRINCIPAL DEL ENCABEZADO
            ===================================
            - Se aplican clases CSS para estilos específicos de JAH
            - Se usa t-attf-class para dinámicamente incluir el ID de la compañía
            - t-att-style aplica estilos CSS desde el reporte
            -->
            <div class="header o_company_layout jah-header" 
                 t-attf-class="header o_company_#{company.id or '1'}_layout jah-header"
                 t-att-style="report_header_style">
                
                <!-- 
                DETERMINACIÓN DE LA COMPAÑÍA
                ============================
                Establecemos la variable 'company' buscando en diferentes lugares:
                1. Primero en el objeto principal (o)
                2. Luego en el documento (doc)
                3. Finalmente en la variable global 'company'
                Esto garantiza que siempre tengamos información de la compañía.
                -->
                <t t-set="company" t-value="o and o.company_id or doc and doc.company_id or company or {}"/>
                
                <!-- 
                CONTENEDOR FLEXIBLE PARA ORGANIZACIÓN
                =====================================
                Usamos flexbox para organizar logo, datos empresa y datos cliente
                en una disposición horizontal responsiva.
                -->
                <div class="jah-header-flex">
                    
                    <!-- 
                    SECCIÓN 1: LOGO DE LA EMPRESA
                    ==============================
                    Contenedor dedicado para mostrar el logo corporativo.
                    -->
                    <div class="jah-header-logo">
                        <!-- 
                        LOGO DINÁMICO
                        - Si la compañía tiene logo: lo muestra como imagen
                        - Si no tiene logo: muestra texto [LOGO] como placeholder
                        - image_data_uri() convierte el binario del logo a URI para HTML
                        -->
                        <img t-if="company.logo" 
                             t-att-src="image_data_uri(company.logo)" 
                             alt="Logo" 
                             class="jah-logo-img"/>
                        <div t-if="not company.logo" class="jah-no-logo">
                            [LOGO]
                        </div>
                    </div>
                    
                    <!-- 
                    SECCIÓN 2: INFORMACIÓN DE LA EMPRESA (JAH)
                    ===========================================
                    Muestra los datos corporativos según requerimientos del brief.
                    Solo se muestra si hay información de compañía disponible.
                    -->
                    <t t-if="company">
                        <div class="jah-company-info">
                            <!-- RAZÓN SOCIAL - Nombre legal de la empresa -->
                            <div class="jah-company-name">
                                <t t-esc="company.name or 'JAH'"/>
                            </div>

                            <!-- CASA MATRIZ - Dirección principal según brief -->
                            <div class="jah-company-branch">
                                <t t-if="company.partner_id and company.partner_id.name">
                                    <t t-esc="company.partner_id.name"/>
                                </t>
                                <t t-else="">
                                    Casa Matriz
                                </t>
                            </div>
                        
                            <!-- DIRECCIÓN COMPLETA - Construida dinámicamente -->
                            <t t-if="company.street or company.street2">
                                <div class="jah-company-address">
                                    <!-- Calle principal -->
                                    <t t-esc="company.street or ''"/>
                                    <!-- Calle secundaria (si existe) -->
                                    <t t-if="company.street2">, <t t-esc="company.street2"/></t>
                                    <!-- Ciudad -->
                                    <t t-if="company.city">, <t t-esc="company.city"/></t>
                                    <!-- Estado/Provincia -->
                                    <t t-if="company.state_id">, <t t-esc="company.state_id.name"/></t>
                                </div>
                            </t>

                            <!-- TELÉFONO - Información de contacto -->
                            <div class="jah-company-phone">
                                Teléfono: <t t-esc="company.phone or 'No registrado'"/>
                            </div>
                        </div>
                    </t>
                    <!-- 
                    FALLBACK: SI NO HAY INFORMACIÓN DE EMPRESA
                    ===========================================
                    Muestra advertencia visible para debugging.
                    -->
                    <t t-else="">
                        <div class="alert alert-warning">
                            No se encontró información de la empresa
                        </div>
                    </t>


                    <!-- 
                    SECCIÓN 3: INFORMACIÓN DEL CLIENTE/PROVEEDOR
                    ============================================
                    Muestra datos del cliente/proveedor según el tipo de documento.
                    Esta sección solo aparece si el documento tiene un partner asociado.
                    -->
                    <t t-if="o and o.partner_id">
                        <div class="jah-client-info">
                            <!-- RAZÓN SOCIAL DEL CLIENTE -->
                            <div class="jah-client-name">
                                Cliente: <t t-esc="o.partner_id.name or 'No registrado'"/>
                            </div>

                            <!-- NIT DEL CLIENTE - Campo fiscal importante para JAH -->
                            <div class="jah-company-nit">
                                <span t-if="o.partner_id.vat">NIT: <t t-esc="o.partner_id.vat"/></span>
                                <span t-if="not o.partner_id.vat">NIT: No registrado</span>
                            </div>

                            <!-- DIRECCIÓN DEL CLIENTE - Similar estructura a dirección empresa -->
                            <div class="jah-client-address">
                                <t t-esc="o.partner_id.street or ''"/>
                                <t t-if="o.partner_id.street2">, <t t-esc="o.partner_id.street2"/></t>
                                <t t-if="o.partner_id.city">, <t t-esc="o.partner_id.city"/></t>
                                <t t-if="o.partner_id.state_id">, <t t-esc="o.partner_id.state_id.name"/></t>
                            </div>
                        
                            <!-- 
                            FECHA DINÁMICA SEGÚN TIPO DE DOCUMENTO
                            ======================================
                            Muestra diferentes fechas dependiendo del modelo del documento.
                            Esto evita mostrar fechas incorrectas entre documentos.
                            -->
                            <div class="jah-company-date">
                                <!-- Orden de Venta: usa fecha de orden -->
                                <t t-if="o._name == 'sale.order' and o.date_order">
                                    Fecha de Orden: <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                                </t>
                                <!-- Factura: usa fecha de factura -->
                                <t t-elif="o._name == 'account.move' and o.invoice_date">
                                    Fecha de Factura: <span t-field="o.invoice_date" t-options='{"widget": "date"}'/>
                                </t>
                                <!-- Nota de Entrega: usa fecha programada -->
                                <t t-elif="o._name == 'stock.picking' and o.scheduled_date">
                                    Fecha de Entrega: <span t-field="o.scheduled_date" t-options='{"widget": "date"}'/>
                                </t>
                                <!-- Pago: usa fecha del pago -->
                                <t t-elif="o._name == 'account.payment' and o.date">
                                    Fecha de Pago: <span t-field="o.date" t-options='{"widget": "date"}'/>
                                </t>
                                <!-- Fallback para otros documentos -->
                                <t t-else="">
                                    Fecha: No hay fecha o no se encontró
                                </t>
                            </div>

                            <!-- 
                            CÓDIGO INTERNO DEL CLIENTE
                            ===========================
                            Muestra referencia personalizada o ID de base de datos.
                            - ref: código personalizado del cliente
                            - id: ID de base de datos como fallback
                            -->
                            <div class="jah-company-client-id">
                                <t t-if="o.partner_id.ref">
                                    Código Cliente: <t t-esc="o.partner_id.ref"/>
                                </t>
                                <t t-else="">
                                    Código Cliente: <t t-esc="o.partner_id.id"/>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- 
                    FALLBACK: SI NO HAY INFORMACIÓN DEL CLIENTE
                    ============================================
                    Aunque el documento tiene objeto 'o', puede no tener partner asociado.
                    Esto puede ocurrir en documentos en borrador o con errores.
                    -->
                    <t t-elif="o and not o.partner_id">
                        <div class="jah-client-info">
                            <div class="alert alert-warning">
                                No se encontró información del cliente
                            </div>
                        </div>
                    </t>

                </div>
            </div>
        </xpath>
    </template>
</odoo>