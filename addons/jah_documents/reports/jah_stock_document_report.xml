<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================= -->
        <!--   TEMPLATE HEREDADO DEL REPORTE ORIGINAL DE DELIVERY     -->
        <!-- ========================================================= -->

        <template id="report_jah_delivery_document" inherit_id="stock.report_delivery_document">


            <!-- ========================================================= -->
            <!-- SECCIÓN 2: TABLA SIMPLIFICADA PARA ESTADO != 'done'       -->
            <!-- - Agregar columnas: Código, Descripción, Unidad,         -->
            <!--   Ordenado, Entregado (sin precios)                      -->
            <!-- ========================================================= -->

            <xpath expr="//table[@name='stock_move_table']//thead" position="replace">
                <thead>
                    <tr>
                        <th name="th_code" class="text-start" style="width: 12%;">
                            <strong>Código</strong>
                        </th>
                        <th name="th_product" class="text-start" style="width: 45%;">
                            <strong>Descripción</strong>
                        </th>
                        <th name="th_unit" class="text-center" style="width: 10%;">
                            <strong>Unidad</strong>
                        </th>
                        <th name="th_ordered" class="text-center" style="width: 12%;">
                            <strong>Ordenado</strong>
                        </th>
                        <th name="th_delivered" class="text-center" style="width: 12%;">
                            <strong>Entregado</strong>
                        </th>
                    </tr>
                </thead>
            </xpath>

            <xpath expr="//table[@name='stock_move_table']//tbody//tr" position="replace">
                <tr t-foreach="lines" t-as="move">
                    
                    <!-- Código del producto -->
                    <td name="td_code" class="text-start">
                        <span t-field="move.product_id.default_code"/>
                    </td>

                    <!-- Descripción del producto -->
                    <td name="td_description" class="text-start">
                        <span t-field="move.product_id.display_name"/>
                        <p t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name" class="text-muted" style="font-size: 9pt; margin: 0;">
                            <span t-field="move.description_picking"/>
                        </p>
                    </td>

                    <!-- Unidad de medida -->
                    <td name="td_unit" class="text-center">
                        <span t-field="move.product_uom"/>
                    </td>

                    <!-- Cantidad ordenada -->
                    <td name="td_ordered" class="text-center">
                        <span t-field="move.product_uom_qty"/>
                    </td>

                    <!-- Cantidad entregada -->
                    <td name="td_delivered" class="text-center">
                        <span t-field="move.quantity"/>
                    </td>

                </tr>
            </xpath>

            <!-- ========================================================= -->
            <!-- SECCIÓN 3: TABLA PARA ESTADO 'done' (Entregado)          -->
            <!-- - Modificar encabezado para mantener consistencia        -->
            <!-- ========================================================= -->

            <xpath expr="//table[@name='stock_move_line_table']//thead" position="replace">
                <thead>
                    <tr>
                        <th name="th_code" class="text-start" style="width: 12%;">
                            <strong>Código</strong>
                        </th>
                        <th name="th_product" class="text-start" style="width: 45%;">
                            <strong>Descripción</strong>
                        </th>
                        <th name="th_unit" class="text-center" style="width: 10%;">
                            <strong>Unidad</strong>
                        </th>
                        <th name="th_ordered" class="text-center" style="width: 12%;">
                            <strong>Ordenado</strong>
                        </th>
                        <th name="th_delivered" class="text-center" style="width: 12%;">
                            <strong>Entregado</strong>
                        </th>
                    </tr>
                </thead>
            </xpath>

            <!-- ========================================================= -->
            <!-- SECCIÓN 4: AGREGAR BLOQUES DE FIRMA                      -->
            <!-- - Se agregan dos firmas al final del documento           -->
            <!-- ========================================================= -->

            <!-- Insertar firmas antes del último oe_structure -->
            <xpath expr="//div[@class='page']//div[t-if='not o.signature']" position="before">

                <!-- Sección de firmas -->
                <div class="row mt-5" style="page-break-inside: avoid;">
                    
                    <!-- Firma: Responsable de Entrega -->
                    <div class="col-6">
                        <div style="margin-top: 60px; text-align: center;">
                            <div style="border-top: 2px solid black; padding-top: 10px; max-width: 300px; margin: 0 auto;">
                                <p style="margin: 0; font-weight: bold;">
                                    RESPONSABLE DE ENTREGA
                                </p>
                                <p style="margin-top: 5px; font-size: 9pt; color: #666;">
                                    Nombre y firma
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Firma: Cliente que Recibe -->
                    <div class="col-6">
                        <div style="margin-top: 60px; text-align: center;">
                            <div style="border-top: 2px solid black; padding-top: 10px; max-width: 300px; margin: 0 auto;">
                                <p style="margin: 0; font-weight: bold;">
                                    CLIENTE QUE RECIBE
                                </p>
                                <p style="margin-top: 5px; font-size: 9pt; color: #666;">
                                    Nombre y firma
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Nota informativa adicional -->
                <div class="row mt-3 mb-3">
                    <div class="col-12 text-center">
                        <p style="font-style: italic; color: #666; font-size: 9pt; margin: 0;">
                            *Las firmas confirman la entrega y recepción conforme de los productos listados*
                        </p>
                    </div>
                </div>

            </xpath>

        </template>

        <!-- ========================================================= -->
        <!-- HERENCIA DEL TEMPLATE DE LÍNEAS AGREGADAS                 -->
        <!-- - Modificar el template externo por separado             -->
        <!-- ========================================================= -->

        <template id="jah_stock_report_delivery_aggregated_move_lines" 
                  inherit_id="stock.stock_report_delivery_aggregated_move_lines">

            <!-- Reemplazar toda la fila para agregar columna de código -->
            <xpath expr="//tr" position="replace">
                <tr t-foreach="aggregated_lines" t-as="line">
                    
                    <!-- Código del producto (NUEVO) -->
                    <td name="td_code" class="text-start">
                        <!-- El método agregado no incluye código por defecto -->
                        <span t-if="aggregated_lines[line].get('code')" t-esc="aggregated_lines[line]['code']"/>
                    </td>

                    <!-- Descripción -->
                    <td name="td_description" class="text-start">
                        <span t-esc="aggregated_lines[line]['name']"/>
                        <p t-if="aggregated_lines[line]['description']" class="text-muted" style="font-size: 9pt; margin: 0;">
                            <span t-esc="aggregated_lines[line]['description']" t-options="{'widget': 'text'}"/>
                        </p>
                    </td>

                    <!-- Unidad (NUEVO) -->
                    <td name="td_unit" class="text-center">
                        <span t-esc="aggregated_lines[line]['product_uom'].name"/>
                    </td>

                    <!-- Ordenado (MODIFICADO - sin packaging) -->
                    <td name="td_ordered" class="text-center">
                        <span t-esc="aggregated_lines[line]['qty_ordered']"
                            t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"/>
                    </td>

                    <!-- Entregado (MODIFICADO - sin packaging) -->
                    <td name="td_delivered" class="text-center">
                        <t t-if="aggregated_lines[line]['quantity']">
                            <span t-esc="aggregated_lines[line]['quantity']"
                                t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"/>
                        </t>
                    </td>

                </tr>
            </xpath>

        </template>

    </data>
</odoo>