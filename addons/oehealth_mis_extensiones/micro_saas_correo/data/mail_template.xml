<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="email_template_bienvenida_instancia" model="mail.template">
        <field name="name">Bienvenida - Tu instancia Odoo está lista</field>
        <field name="model_id" ref="micro_saas.model_odoo_docker_instance"/>
        <field name="subject">🎉 ¡Tu instancia Odoo está lista, {{ object.partner_id.name }}!</field>
        <field name="email_from">{{ (object.env['ir.config_parameter'].sudo().get_param('mail.default.from') or user.email_formatted) }}</field>
        <field name="email_to">{{ object.partner_id.email }}</field>
        <field name="body_html"><![CDATA[
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Bienvenida a tu instancia Odoo</title>
</head>
<body style="margin:0; padding:0; background-color:#f0f4f8; font-family: 'Segoe UI', Arial, sans-serif;">

    <!-- Wrapper -->
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f0f4f8; padding: 40px 0;">
        <tr>
            <td align="center">

                <!-- Card principal -->
                <table width="600" cellpadding="0" cellspacing="0" border="0"
                       style="background-color:#ffffff; border-radius:16px; overflow:hidden;
                              box-shadow: 0 8px 30px rgba(0,0,0,0.12); max-width:600px;">

                    <!-- HEADER con gradiente -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #6C3FC5 0%, #9B59B6 50%, #3498DB 100%);
                                   padding: 50px 40px; text-align:center;">
                            <!-- Ícono -->
                            <div style="width:80px; height:80px; background:rgba(255,255,255,0.2);
                                        border-radius:50%; margin:0 auto 20px; display:inline-block;
                                        line-height:80px; font-size:40px;">
                                🚀
                            </div>
                            <h1 style="color:#ffffff; margin:0 0 8px; font-size:28px; font-weight:700;
                                       letter-spacing:-0.5px;">
                                ¡Tu instancia está lista!
                            </h1>
                            <p style="color:rgba(255,255,255,0.85); margin:0; font-size:16px;">
                                Tu entorno Odoo personalizado ha sido creado exitosamente
                            </p>
                        </td>
                    </tr>

                    <!-- SALUDO -->
                    <tr>
                        <td style="padding: 40px 40px 20px;">
                            <p style="color:#2d3748; font-size:17px; margin:0 0 16px; line-height:1.6;">
                                Hola <strong style="color:#6C3FC5;">{{ object.partner_id.name }}</strong>,
                            </p>
                            <p style="color:#4a5568; font-size:15px; margin:0; line-height:1.7;">
                                Nos complace informarte que tu instancia Odoo ha sido configurada y está
                                lista para usar. A continuación encontrarás todos los datos de acceso
                                que necesitas para comenzar.
                            </p>
                        </td>
                    </tr>

                    <!-- CARD DE ACCESO -->
                    <tr>
                        <td style="padding: 10px 40px 30px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                                   style="background: linear-gradient(135deg, #f8f4ff 0%, #eff6ff 100%);
                                          border-radius:12px; border: 1px solid #e2d9f3; overflow:hidden;">
                                <!-- Título card -->
                                <tr>
                                    <td colspan="2"
                                        style="background: linear-gradient(90deg, #6C3FC5, #3498DB);
                                               padding:14px 24px;">
                                        <span style="color:#fff; font-weight:700; font-size:14px;
                                                     text-transform:uppercase; letter-spacing:1px;">
                                            🔑 Datos de Acceso
                                        </span>
                                    </td>
                                </tr>

                                <!-- URL -->
                                <tr>
                                    <td style="padding:18px 24px 8px; color:#718096; font-size:13px;
                                               font-weight:600; text-transform:uppercase; letter-spacing:0.5px;
                                               width:35%;">
                                        🌐 URL de tu Odoo
                                    </td>
                                    <td style="padding:18px 24px 8px;">
                                        <a href="{{ object.instance_url }}"
                                           style="color:#6C3FC5; font-weight:700; font-size:15px;
                                                  text-decoration:none; word-break:break-all;">
                                            {{ object.instance_url }}
                                        </a>
                                    </td>
                                </tr>

                                <!-- Separador -->
                                <tr>
                                    <td colspan="2" style="padding:0 24px;">
                                        <hr style="border:none; border-top:1px solid #e2d9f3; margin:4px 0;"/>
                                    </td>
                                </tr>

                                <!-- Nombre instancia -->
                                <tr>
                                    <td style="padding:10px 24px 8px; color:#718096; font-size:13px;
                                               font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">
                                        📦 Instancia
                                    </td>
                                    <td style="padding:10px 24px 8px; color:#2d3748; font-size:15px; font-weight:600;">
                                        {{ object.name }}
                                    </td>
                                </tr>

                                <!-- Separador -->
                                <tr>
                                    <td colspan="2" style="padding:0 24px;">
                                        <hr style="border:none; border-top:1px solid #e2d9f3; margin:4px 0;"/>
                                    </td>
                                </tr>

                                <!-- Usuario -->
                                <tr>
                                    <td style="padding:10px 24px 8px; color:#718096; font-size:13px;
                                               font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">
                                        👤 Usuario
                                    </td>
                                    <td style="padding:10px 24px 8px; color:#2d3748; font-size:15px; font-weight:600;">
                                        admin
                                    </td>
                                </tr>

                                <!-- Separador -->
                                <tr>
                                    <td colspan="2" style="padding:0 24px;">
                                        <hr style="border:none; border-top:1px solid #e2d9f3; margin:4px 0;"/>
                                    </td>
                                </tr>

                                <!-- Contraseña -->
                                <tr>
                                    <td style="padding:10px 24px 18px; color:#718096; font-size:13px;
                                               font-weight:600; text-transform:uppercase; letter-spacing:0.5px;">
                                        🔒 Contraseña
                                    </td>
                                    <td style="padding:10px 24px 18px; color:#2d3748; font-size:15px; font-weight:600;">
                                        admin
                                        <span style="color:#e53e3e; font-size:12px; font-weight:400;
                                                     display:block; margin-top:4px;">
                                            ⚠️ Por seguridad, cambia tu contraseña al ingresar por primera vez.
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- BOTÓN CTA -->
                    <tr>
                        <td style="padding: 0 40px 40px; text-align:center;">
                            <a href="{{ object.instance_url }}"
                               style="display:inline-block; background: linear-gradient(135deg, #6C3FC5, #3498DB);
                                      color:#ffffff; text-decoration:none; padding:16px 48px;
                                      border-radius:50px; font-size:16px; font-weight:700;
                                      letter-spacing:0.5px; box-shadow: 0 4px 15px rgba(108,63,197,0.4);">
                                🚀 Acceder a mi Odoo
                            </a>
                        </td>
                    </tr>

                    <!-- PASOS SIGUIENTES -->
                    <tr>
                        <td style="padding: 0 40px 40px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                                   style="background:#f7fafc; border-radius:12px; padding:24px; border:1px solid #e2e8f0;">
                                <tr>
                                    <td>
                                        <p style="color:#2d3748; font-size:15px; font-weight:700; margin:0 0 16px;">
                                            📋 Primeros pasos recomendados:
                                        </p>
                                        <table width="100%" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td style="padding:6px 0; color:#4a5568; font-size:14px;">
                                                    ✅ &nbsp; Cambia tu contraseña de administrador
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0; color:#4a5568; font-size:14px;">
                                                    ✅ &nbsp; Configura el nombre y logo de tu empresa
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0; color:#4a5568; font-size:14px;">
                                                    ✅ &nbsp; Instala los módulos que necesitas
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding:6px 0; color:#4a5568; font-size:14px;">
                                                    ✅ &nbsp; Agrega a tus usuarios y configura permisos
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- SOPORTE -->
                    <tr>
                        <td style="padding: 0 40px 40px;">
                            <p style="color:#718096; font-size:14px; text-align:center; margin:0; line-height:1.6;">
                                ¿Tienes alguna duda? Contáctanos y con gusto te ayudamos.<br/>
                                <strong style="color:#6C3FC5;">Equipo de Soporte</strong>
                            </p>
                        </td>
                    </tr>

                    <!-- FOOTER -->
                    <tr>
                        <td style="background: linear-gradient(135deg, #2d3748, #4a5568);
                                   padding:24px 40px; text-align:center; border-radius:0 0 16px 16px;">
                            <p style="color:rgba(255,255,255,0.6); font-size:12px; margin:0; line-height:1.6;">
                                Este correo fue generado automáticamente por el sistema Micro SaaS.<br/>
                                Por favor no respondas a este mensaje directamente.
                            </p>
                        </td>
                    </tr>

                </table>
                <!-- Fin card principal -->

            </td>
        </tr>
    </table>

</body>
</html>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
