<odoo>

    <record id="oeh_medical_patient_view_whatsapp_extend_es" model="ir.ui.view">
        <field name="model">oeh.medical.patient</field>
        <field name="inherit_id" ref="oehealth_whatsapp.oeh_medical_patient_view_whatsapp_extend"/>
        <field name="arch" type="xml">
