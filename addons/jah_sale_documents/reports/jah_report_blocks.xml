<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ================================================= -->
        <!-- BLOQUE ENCABEZADO UNIFICADO JAH -->
        <!-- ================================================= -->
        <template id="jah_report_header">
            <div class="row" style="height: 3cm; text-align: center; margin-bottom: 15px;">
                <div class="col-12">
                    <!-- Logo de JAH -->
                    <img t-att-src="'data:image/png;base64,%s' % (company.logo or '')"
                         style="height:3cm; display:block; margin:auto;"/>
                </div>
                <div class="col-12 mt-1">
                    <!-- Datos de la empresa -->
                    <strong t-field="company.name"/>
                    <br/>
                    <span t-field="company.street"/>
                    <span t-if="company.phone"> - Tel: <span t-field="company.phone"/></span>
                </div>
            </div>
        </template>

        <!-- ================================================= -->
        <!-- BLOQUE INFORMACIÓN DEL CLIENTE HOMOGÉNEA -->
        <!-- ================================================= -->
        <template id="jah_report_customer_info">
            <div id="informations" class="row mt-4 mb-2">
                <div class="col-auto col-3 mw-100 mb-2">
                    <strong>Nombre:</strong><br/>
                    <span class="m-0" t-field="doc.partner_id.name"/>
                </div>

                <div t-if="doc.partner_id.vat" class="col-auto col-3 mw-100 mb-2">
                    <strong>NIT:</strong><br/>
                    <span class="m-0" t-field="doc.partner_id.vat"/>
                </div>

                <div t-if="doc.partner_id.street" class="col-auto col-3 mw-100 mb-2">
                    <strong>Dirección:</strong><br/>
                    <span class="m-0" t-field="doc.partner_id.street"/>
                </div>

                <div class="col-auto col-3 mw-100 mb-2">
                    <strong>Fecha:</strong><br/>
                    <span class="m-0" t-field="doc.date_order" t-options='{"widget": "date"}'/>
                </div>

                <div t-if="doc.partner_id.ref" class="col-auto col-3 mw-100 mb-2">
                    <strong>Código Cliente:</strong><br/>
                    <span class="m-0" t-field="doc.partner_id.ref"/>
                </div>
            </div>
        </template>

        <!-- ================================================= -->
        <!-- PIE DE PÁGINA ESTÁNDAR JAH (solo ventas) -->
        <!-- ================================================= -->
        <template id="jah_report_footer">
            <div class="footer text-center mt-3">
                <p style="font-size: 9pt; color: #666;">
                    Texto estándar de JAH aquí.
                </p>
            </div>
        </template>

    </data>
</odoo>
