<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <template id="external_layout_jah" inherit_id="web.external_layout_standard">
    <xpath expr="//div[contains(@class, 'header')]" position="replace">
        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
            <div class="row" style="height: 3cm; align-items: center; border-bottom: 2px solid #875A7B; padding-bottom: 10px;">
                
                <div class="col-4 text-center" style="border-right: 1px solid #dee2e6;">
                    <img t-if="company.logo" 
                         t-att-src="image_data_uri(company.logo)" 
                         alt="Logo JAH" 
                         style="max-height: 2.5cm; max-width: 100%; object-fit: contain;"/>
                </div>
                
                <div class="col-8" style="padding-left: 20px;">
                    <h4 class="mb-1" style="color: #875A7B; font-weight: bold; font-size: 14pt;">
                        <span t-field="company.name"/>
                    </h4>
                    
                    <p class="mb-0" style="font-size: 10pt; line-height: 1.3;">
                        <strong>Casa Matriz:</strong>
                        <span t-field="company.street"/>
                        <span t-if="company.city">, <span t-field="company.city"/></span>
                        <span t-if="company.state_id">, <span t-field="company.state_id.name"/></span>
                        <span t-if="company.country_id">, <span t-field="company.country_id.name"/></span>
                    </p>
                    
                    <p class="mb-0" style="font-size: 10pt; line-height: 1.3;">
                        <span t-if="company.phone">
                            <i class="fa fa-phone"/> <span t-field="company.phone"/>
                        </span>
                        <span t-if="company.email" style="margin-left: 15px;">
                            <i class="fa fa-envelope"/> <span t-field="company.email"/>
                        </span>
                    </p>
                    
                    <p class="mb-0" style="font-size: 10pt; line-height: 1.3;">
                        <span t-if="company.vat">
                            <strong>NIT:</strong> <span t-field="company.vat"/>
                        </span>
                    </p>
                </div>
            </div>
        </div>
    </xpath>
    
    <xpath expr="//div[contains(@class, 'footer')]" position="replace">
        <div class="footer o_standard_footer o_company_#{company.id}_layout">
            <div style="border-top: 2px solid #875A7B; padding-top: 10px; margin-top: 20px;">
                <div class="row">
                    <div class="col-12 text-center">
                        <p class="mb-1" style="font-size: 9pt; color: #666;">
                            <strong>JAH - Soluciones Profesionales</strong>
                        </p>
                        <p class="mb-0" style="font-size: 8pt; color: #999;">
                            Este documento es válido para efectos fiscales y comerciales. Para consultas comuníquese con nosotros.
                        </p>
                    </div>
                </div>
                
                <div class="row mt-2">
                    <div class="col-6 text-start" style="font-size: 8pt; color: #999;">
                        <span t-field="company.name"/> - 
                        <span t-if="company.phone" t-field="company.phone"/>
                    </div>
                    <div class="col-6 text-end" style="font-size: 8pt; color: #999;">
                        Página: <span class="page"/> de <span class="topage"/>
                    </div>
                </div>
            </div>
        </div>
    </xpath>
</template>
        
    </data>
</odoo>