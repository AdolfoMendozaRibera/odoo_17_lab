<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ============================================ -->
        <!-- TEMPLATE PERSONALIZADO JAH - LAYOUT COMPLETO -->
        <!-- ============================================ -->
        
        <template id="jah_external_layout" name="JAH External Layout">
            <t t-if="not o" t-set="o" t-value="doc"/>
            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>
            
            <!-- HEADER JAH -->
            <div t-attf-class="header o_company_#{company.id}_layout jah_custom_header" 
                 t-att-style="report_header_style"
                 style="min-height: 30mm; margin-bottom: 5mm; border-bottom: 1px solid #dee2e6;">
                <div class="row" style="padding: 10px 0;">
                    <!-- Logo -->
                    <div class="col-4 text-center" style="display: flex; align-items: center; justify-content: center;">
                        <img t-if="company.logo" 
                             t-att-src="image_data_uri(company.logo)" 
                             style="max-height: 25mm; max-width: 100%; object-fit: contain;" 
                             alt="Company Logo"/>
                    </div>
                    
                    <!-- Datos de la Empresa -->
                    <div class="col-8" style="font-size: 10pt; padding-left: 20px;">
                        <div style="margin-bottom: 3px;">
                            <strong style="font-size: 12pt;" t-field="company.name"/>
                        </div>
                        
                        <div t-if="company.company_casa_matriz_address" style="margin-bottom: 2px;">
                            <strong>Casa Matriz: </strong>
                            <span t-field="company.company_casa_matriz_address"/>
                        </div>
                        
                        <div t-if="company.street" style="margin-bottom: 2px;">
                            <strong>Dirección: </strong>
                            <span t-field="company.street"/>
                            <span t-if="company.street2" t-field="company.street2"/>
                        </div>
                        
                        <div style="margin-bottom: 2px;">
                            <span t-if="company.city" t-field="company.city"/>
                            <span t-if="company.state_id"> - <span t-field="company.state_id.name"/></span>
                            <span t-if="company.country_id"> - <span t-field="company.country_id.name"/></span>
                        </div>
                        
                        <div t-if="company.phone" style="margin-bottom: 2px;">
                            <strong>Teléfono: </strong>
                            <span t-field="company.phone"/>
                        </div>
                        
                        <div t-if="company.company_nit">
                            <strong>NIT: </strong>
                            <span t-field="company.company_nit"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ARTICLE/BODY -->
            <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout" 
                 t-att-data-oe-model="o and o._name" 
                 t-att-data-oe-id="o and o.id" 
                 t-att-data-oe-lang="o and o.env.context.get('lang')">
                <div class="pt-3">
                    <t t-call="web.address_layout"/>
                </div>
                <t t-out="0"/>
            </div>

            <!-- FOOTER JAH -->
            <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout jah_custom_footer">
                <div class="text-center" style="border-top: 1px solid black;">
                    <ul class="list-inline mb4">
                        <li t-if="company.phone" class="list-inline-item d-inline">
                            Teléfono: <span t-field="company.phone"/>
                        </li>
                        <li t-if="company.email" class="list-inline-item d-inline">
                            Email: <span t-field="company.email"/>
                        </li>
                        <li t-if="company.website" class="list-inline-item d-inline">
                            Web: <span t-field="company.website"/>
                        </li>
                    </ul>

                    <!-- Footer personalizado solo para documentos de venta -->
                    <t t-set="doc_model" t-value="docs[0]._name if docs else ''"/>
                    <div t-if="doc_model in ['sale.order']" 
                         style="font-size: 9pt; margin-top: 10px; padding-top: 5px; color: #666;">
                        <p>
                            Este documento es una representación impresa de un documento electrónico generado en Odoo.
                            <br/>
                            Para mayor información contacte con nuestro equipo de ventas.
                        </p>
                    </div>

                    <div class="text-muted" t-if="report_type == 'pdf'">
                        Página: <span class="page"/> de <span class="topage"/>
                    </div>
                </div>
            </div>
        </template>

        <!-- ============================================ -->
        <!-- REPORTE DE VENTAS JAH - Usa nuestro layout y plantilla personalizada -->
        <!-- ============================================ -->
        
        <template id="jah_report_saleorder" name="JAH Sale Order Report">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="jah_sale_documents.jah_external_layout">
                        <t t-call="jah_sale_documents.jah_report_saleorder_document"/>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>