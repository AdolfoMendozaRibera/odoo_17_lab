<odoo>
  <data>
      <!-- VISTA ARBOL -->
      <record id="view_paciente_tree" model="ir.ui.view">
        <field name="name">hospital.paciente.tree</field>
        <field name="model">hospital.paciente</field>
        <field name="arch" type="xml">
          <tree string="Lista de Pacientes" create="true" edit="true" delete="true">
            <field name="nombre"/>
            <field name="fecha_nacimiento"/>
            <field name="fecha_ingreso" placeholder="NA"/>
            <field name="genero"/>
          </tree>
        </field>
      </record>

      <!-- VISTA FORMULARIO -->
      <record id="view_paciente_form" model="ir.ui.view">
        <field name="name">hospital.paciente.form</field>
        <field name="model">hospital.paciente</field>
        <field name="arch" type="xml">
          <form string="Paciente">
            <sheet>
              <group>
                <field name="nombre" placeholder="Nombre del Paciente"/>
              </group>

              <group string="Datos del paciente">
                <field name="fecha_nacimiento"/>
                <field name="genero"/>
              </group>

              <group string="Información de Ingreso">
                <field name="fecha_ingreso"/>
              </group>

              <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                </div>
            </sheet>
          </form>
        </field>
      </record>

      <!-- ACCIÓN DE VENTANA -->
      <record model="ir.actions.act_window" id="action_hospital3_window">
        <field name="name">Pacientes</field>
        <field name="res_model">hospital.paciente</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5,0,0),
                          (0,0,{'view_mode':'tree','view_id':ref('view_paciente_tree')}),
                          (0,0,{'view_mode':'form','view_id':ref('view_paciente_form')})]"/>
        <field name="context">{}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crea tu primer paciente
          </p>
          <p>
            Haz clic en "Nuevo" para agregar un paciente.
          </p>
        </field>
      </record>

  </data>
</odoo>
