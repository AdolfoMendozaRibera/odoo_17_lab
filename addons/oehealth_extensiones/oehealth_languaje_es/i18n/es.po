"                        View\n"
"                    </a>\n"
"                </div>\n"
"                <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n"
"                    <tr>\n"
"                        <!--                        % if not recurrent:-->\n"
"                        <td width=\"130px;\">\n"
"                            <div style=\"border-top-left-radius: 3px; border-top-right-radius: 3px; font-size: 12px; border-collapse: separate; text-align: center; font-weight: bold; color: #ffffff; min-height: 18px; background-color: #875A7B; border: 1px solid #875A7B;\">\n"
"                                <t t-out=\"object.get_interval('dayname', tz=object.partner_id.tz if not object.allday else None)\"></t>\n"
"                            </div>\n"
"                            <div style=\"font-size: 48px; min-height: auto; font-weight: bold; text-align: center; color: #5F5F5F; background-color: #F8F8F8; border: 1px solid #875A7B;\">\n"
"                                <t t-out=\"object.get_interval('day', tz=object.partner_id.tz if not object.allday else None)\"></t>\n"
"                            </div>\n"
"                            <div style=\"font-size: 12px; text-align: center; font-weight: bold; color: #ffffff; background-color: #875A7B;\">\n"
"                                <t t-out=\"object.get_interval('month', tz=object.partner_id.tz if not object.allday else None)\"></t>\n"
"                            </div>\n"
"                            <div style=\"border-collapse: separate; color: #5F5F5F; text-align: center; font-size: 12px; border-bottom-right-radius: 3px; font-weight: bold; border: 1px solid #875A7B; border-bottom-left-radius: 3px;\">\n"
"                                <t t-out=\"not object.allday and object.get_interval('time', tz=object.partner_id.tz) or ''\"></t>\n"
"                            </div>\n"
"                        </td>\n"
"                        <td width=\"20px;\"></td>\n"
"                        <!--                        % endif-->\n"
"                        <td style=\"padding-top: 5px;\">\n"
"                            <p>\n"
"                                <strong>Details of the event</strong>\n"
"                            </p>\n"
"                            <ul>\n"
"                                <li>\n"
"                                    Attendees\n"
"                                    <ul>\n"
"                                        <li>\n"
"                                            <span style=\"margin-left:5px\"><t t-out=\"object.patient.name\"></t></span>\n"
"                                        </li>\n"
"                                        <li>\n"
"                                            <span style=\"margin-left:5px\"><t t-out=\"object.doctor.name\"></t></span>\n"
"                                        </li>\n"
"                                    </ul>\n"
"                                </li>\n"
"                                <li>\n"
"                                    Meeting URL\n"
"                                    <ul>\n"
"                                        <li>\n"
"                                            <span><t t-out=\"object.invitation_text\"></t></span>\n"
"                                        </li>\n"
"                                    </ul>\n"
"                                </li>\n"
"                            </ul>\n"
"                        </td>\n"
"                    </tr>\n"
"                </table>\n"
"                <br>\n"
"                Thank you,\n"
"                <t t-if=\"object.partner_id.user_id.signature\">\n"
"                <br>\n"
"                <t t-out=\"object.partner_id.user_id.signature or ''\"></t>\n"
"                </t>\n"
"            </div>\n"
"        "
msgstr ""
"<div>\n"
"                <p>\n"
"                    Hola <t t-out=\"object.patient.name or ''\">,</t>\n"
"                    <br>\n"
"                    <br>\n"
