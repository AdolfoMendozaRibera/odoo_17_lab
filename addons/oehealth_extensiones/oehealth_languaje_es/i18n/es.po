#. module: oehealth
#: model:mail.template,body_html:oehealth.oeh_email_template_prescription
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <!--            Dear {{ object.patient.name }},-->\n"
"                    Dear\n"
"                    <t t-out=\"object.patient.name or ''\">,</t>\n"
"                    <br>\n"
"                    <br>\n"
"                    Please find your attached prescription\n"
"                    <strong>\n"
"                        <t t-out=\"object.patient.name or ''\"></t>\n"
"                    </strong>\n"
"                    dated\n"
"                    <strong>\n"
"                        <t t-out=\"object.date or ''\"></t>\n"
"                    </strong>\n"
"                    <t t-if=\"object.institution\">\n"
"                        and generated at\n"
"                        <strong>\n"
"                            <t t-out=\"object.institution.name or ''\"></t>\n"
"                        </strong>\n"
"                    </t>\n"
"                    <br>\n"
"                    <br>\n"
"                    Do not hesitate to contact us if you have any questions.\n"
"                    <br>\n"
"                </p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <!--            Estimado/a {{ object.patient.name }},-->\n"
"                    Estimado/a\n"
"                    <t t-out=\"object.patient.name or ''\">,</t>\n"
"                    <br>\n"
"                    <br>\n"
"                    Adjunto encontrará su prescripción médica para\n"
"                    <strong>\n"
"                        <t t-out=\"object.patient.name or ''\"></t>\n"
"                    </strong>\n"
"                    con fecha\n"
"                    <strong>\n"
"                        <t t-out=\"object.date or ''\"></t>\n"
"                    </strong>\n"
"                    <t t-if=\"object.institution\">\n"
"                        y generada en\n"
"                        <strong>\n"
"                            <t t-out=\"object.institution.name or ''\"></t>\n"
"                        </strong>\n"
"                    </t>\n"
"                    <br>\n"
"                    <br>\n"
"                    No dude en contactarnos si tiene alguna pregunta.\n"
"                    <br>\n"
"                </p>\n"
"            </div>\n"
"        "

#. module: oehealth
#: model:mail.template,body_html:oehealth.oeh_email_template_meeting_invitation
msgid ""
"<div>\n"
"                <p>\n"
"                    Hello <t t-out=\"object.patient.name or ''\">,</t>\n"
"                    <br>\n"
"                    <br>\n"
"                    <t t-out=\"object.patient.partner_id.name\"></t> invited you to the <t t-out=\"object.name\"></t> meeting.\n"
"                </p>\n"
"                <div style=\"text-align: left; margin: 16px 0px 16px 0px;\">\n"
"<!--                    <a href=\"/web#/id=${object.id}/view_type=form/model=oeh.medical.appointment\"-->\n"
"<!--                       style=\"padding: 5px 5px; color: #FFFFFF; text-decoration: none; background-color: #875A7B; border: 1px solid #875A7B; border-radius: 3px\">-->\n"
"<!--                        View-->\n"
"<!--                    </a>-->\n"
