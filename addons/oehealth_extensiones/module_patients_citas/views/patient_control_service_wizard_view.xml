<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- FORM VIEW PARA WIZARD DE SERVICIO -->
        <record id="view_patient_control_service_wizard_form" model="ir.ui.view">
            <field name="name">patient.control.service.wizard.form</field>
            <field name="model">patient.control.service.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <div style="max-width: 600px; margin: 0 auto;">
                        <div class="alert alert-info" style="margin-bottom: 20px; text-align: center;">
                            <strong>Seleccione el tipo de servicio</strong>
                            <p>Elige el plan que mejor se ajuste a tus necesidades:</p>
                        </div>
                        
                        <group>
                            <field name="service_type" widget="radio" options="{'horizontal': False}"/>
                        </group>
                    </div>
                    
                    <footer>
                        <button name="action_confirm" type="object" string="Continuar" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>