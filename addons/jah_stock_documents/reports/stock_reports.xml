<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Template para Nota de Entrega JAH -->
        <template id="jah_report_delivery_document" inherit_id="stock.report_delivery_document">
            
            <!-- ========================================= -->
            <!-- 1. PRUEBA - Texto visible para confirmar -->
            <!-- ========================================= -->
            <xpath expr="//div[contains(@class, 'page')]" position="inside">
                <div style="background: yellow; border: 3px solid red; padding: 15px; margin: 10px 0; text-align: center; font-weight: bold;">
                    ⚡ NOTA DE ENTREGA JAH - PERSONALIZADA ⚡
                </div>
            </xpath>

            <!-- ========================================= -->
            <!-- 2. OCULTAR PRECIOS Y TOTALES - MÉTODO SEGURO -->
            <!-- ========================================= -->
            
            <!-- Primero, veamos qué hay en el reporte original -->
            <!-- Comentamos los xpath problemáticos y usamos uno seguro -->
            
            <!-- Ocultar columnas de precio (si existen) -->
            <xpath expr="//table//th[contains(text(), 'Price')]" position="replace"/>
            <xpath expr="//table//th[contains(text(), 'Cost')]" position="replace"/>
            
            <!-- Ocultar columna Subtotal/Total -->
            <xpath expr="//table//th[contains(text(), 'Subtotal') or contains(text(), 'Total')]" position="replace"/>
            
            <!-- Ocultar celdas de precio (si existen) -->
            <xpath expr="//table//td[contains(@class, 'price') or contains(@class, 'cost')]" position="replace"/>
            <xpath expr="//table//td[contains(@class, 'subtotal') or contains(@class, 'total')]" position="replace"/>

            <!-- ========================================= -->
            <!-- 3. AGREGAR COLUMNA "UNIDAD" -->
            <!-- ========================================= -->
            
            <!-- Buscar columna Descripción (puede ser la 2da columna) -->
            <xpath expr="//table/thead/tr/th[2]" position="after">
                <th class="text-center" style="width: 10%;">Unidad</th>
            </xpath>
            
            <!-- Agregar celda de Unidad en cada fila (3ra columna) -->
            <xpath expr="//table/tbody/tr/td[2]" position="after">
                <td class="text-center">
                    <span t-field="line.product_id.uom_id.name"/>
                </td>
            </xpath>

            <!-- ========================================= -->
            <!-- 4. RENOMBRAR COLUMNAS DE CANTIDAD -->
            <!-- ========================================= -->
            
            <!-- Columna 4: Solicitar/Demanda a Ordenado -->
            <xpath expr="//table/thead/tr/th[4]" position="attributes">
                <attribute name="t-raw">'Ordenado'</attribute>
            </xpath>
            
            <!-- Columna 5: Hecha/Done a Entregado -->
            <xpath expr="//table/thead/tr/th[5]" position="attributes">
                <attribute name="t-raw">'Entregado'</attribute>
            </xpath>

            <!-- ========================================= -->
            <!-- 5. AGREGAR FIRMAS AL FINAL -->
            <!-- ========================================= -->
            
            <xpath expr="//div[contains(@class, 'page')]" position="inside">
                <div class="row" style="margin-top: 80px; padding-top: 20px; border-top: 1px solid #ccc; page-break-inside: avoid;">
                    
                    <!-- Firma Responsable de Entrega -->
                    <div class="col-6">
                        <div style="text-align: center;">
                            <div style="border-top: 2px solid black; width: 80%; margin: 0 auto; padding-top: 10px;">
                                <p style="margin: 0; font-weight: bold; font-size: 11pt;">
                                    RESPONSABLE DE ENTREGA
                                </p>
                                <p style="margin: 5px 0; font-size: 10pt; color: #666;">
                                    Nombre: _______________________________
                                </p>
                                <p style="margin: 0; font-size: 10pt; color: #666;">
                                    Firma: _______________________________
                                </p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Firma Cliente que Recibe -->
                    <div class="col-6">
                        <div style="text-align: center;">
                            <div style="border-top: 2px solid black; width: 80%; margin: 0 auto; padding-top: 10px;">
                                <p style="margin: 0; font-weight: bold; font-size: 11pt;">
                                    CLIENTE QUE RECIBE
                                </p>
                                <p style="margin: 5px 0; font-size: 10pt; color: #666;">
                                    Nombre: _______________________________
                                </p>
                                <p style="margin: 0; font-size: 10pt; color: #666;">
                                    Firma: _______________________________
                                </p>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </xpath>

        </template>

        <!-- ============================================ -->
        <!-- REGISTRAR EL REPORTE JAH -->
        <!-- ============================================ -->
        
        <record id="jah_report_delivery_action" model="ir.actions.report">
            <field name="name">Nota de Entrega JAH</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">jah_stock_documents.jah_report_delivery_document</field>
            <field name="print_report_name">'Nota de Entrega - %s' % (object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>