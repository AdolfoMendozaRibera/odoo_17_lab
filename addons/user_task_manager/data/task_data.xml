<odoo>
    <!-- Cron Job para notificar tareas vencidas (opcional) -->
    <record id="ir_cron_notify_overdue_tasks" model="ir.cron">
        <field name="name">Notificar Tareas Vencidas</field>
        <field name="model_id" ref="model_user_task" />
        <field name="state">code</field>
        <field name="code">model._cron_notify_overdue_tasks()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False" />
        <!-- Activa este cron si quieres notificaciones automáticas -->
    </record>
</odoo>