<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- TEMPLATE QUE HEREDA DEL REPORTE ORIGINAL                  -->
    <!-- Y AGREGA UN NUEVO CAMPO "Días Restantes"                  -->
    <!-- ========================================================= -->
    <template id="report_tarea_con_dias"
              inherit_id="mi_gestor_tareas.report_tarea_template">
        <!--
            inherit_id:
                Permite modificar un template ya existente sin copiarlo todo.
                Aquí estás heredando el template original:
                mi_gestor_tareas.report_tarea_template
        -->

        <!--
            XPATH:
            Busca el nodo <p> cuyo <strong> contiene EXACTO el texto
            'Fecha Límite:' dentro del template original.
            
            expr="//p[strong='Fecha Límite:']"
                //p                -> busca todos los <p> en el documento
                [strong='Fecha Límite:']
                                 -> con un hijo <strong> cuyo contenido
                                    de texto sea exactamente 'Fecha Límite:'
            
            position="before":
                Inserta el nuevo bloque ANTES de ese <p>.
        -->

        <!-- Más preciso si sabes la etiqueta exacta. 
        <! ✅ Fácil de leer y mantener.-->
        <!-- ⚠️ Se rompe si cambian la etiqueta (h2 → span). -->
        <xpath expr="//h2[@t-field='o.name']" position="after">
            <p class="class_modificando_texto">
                <strong>Nombre que si debes recordar:</strong>
                <span t-field="o.name"/>
            </p>
        </xpath>


        <!-- Selecciona cualquier etiqueta con ese atributo único. -->
        <!-- ✅ Robusto y seguro.  -->
        <!-- ⚠️ Inserta en todos los elementos que tengan ese t-field. Si solo hay uno, perfecto. -->
        <xpath expr="//*[@t-field='o.name']" position="before">
            <p class="class_modificando_texto">Detalle de la tarea: </p>
        </xpath>

        <xpath expr="//p[strong='Fecha Límite:']" position="before">

            <!-- Nuevo bloque que se agregará antes de "Fecha Límite" -->
            <p id="id_dias_restantes">
                <strong>Días Restantes:</strong>

                <!--
                    t-field="o.dias_restantes"
                    Muestra el valor del campo "dias_restantes"
                    del registro actual (o).
                    
                    Este campo debe existir en tu modelo Python
                    mi.gestor.tareas.tarea
                -->
                <span t-field="o.dias_restantes"/>
            </p>
        </xpath>

        <xpath expr="//p[@id='id_dias_restantes']" position="replace">
            <p id="id_dias_restantes_modificado">
                <strong>Días Restantes (modificado):</strong>
                <span t-field="o.dias_restantes"/>
            </p>
        </xpath>

        <!-- Si habra varias p (contains)-->
        <!-- POR defecto solo afectaran al primer class, si quieres a varios usa t-foreach-->
        <xpath expr="//p[contains(@class, 'class_modificando_texto')]" position="before">
            <p>
                <em>Este es un texto agregado después del bloque modificado.</em>
            </p>
            <span t-field="o.name"/> 
        </xpath>

    </template>


    <!-- ========================================================= -->
    <!-- NUEVA ACCIÓN DE REPORTE                                   -->
    <!-- Permite imprimir el reporte modificado                     -->
    <!-- SIN reemplazar el original                                -->
    <!-- ========================================================= -->
    <record id="action_report_tarea_con_dias" model="ir.actions.report">

        <!-- Nombre visible cuando el usuario vaya a 'Imprimir' -->
        <field name="name">Imprimir Tarea (con Días)</field>

        <!-- Modelo al que pertenece este reporte -->
        <field name="model">mi.gestor.tareas.tarea</field>

        <!-- Tipo: PDF generado con el motor QWeb -->
        <field name="report_type">qweb-pdf</field>

        <!-- Nombre técnico del template que se usará -->
        <!-- Debe coincidir con: id="report_tarea_con_dias" del template -->
        <field name="report_name">mi_gestor_tareas.report_tarea_con_dias</field>

        <!-- Archivo usado por el reporte (normalmente igual al nombre) -->
        <field name="report_file">mi_gestor_tareas.report_tarea_con_dias</field>

        <!-- Vincular el reporte al modelo para que aparezca en "Imprimir" -->
        <field name="binding_model_id" ref="model_mi_gestor_tareas_tarea"/>

        <!-- Es un tipo de binding tipo reporte -->
        <field name="binding_type">report</field>

    </record>

</odoo>
