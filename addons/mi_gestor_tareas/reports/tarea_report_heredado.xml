<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HERENCIA simple: agregar días restantes antes de fecha límite -->
    <template id="report_tarea_con_dias" 
              inherit_id="mi_gestor_tareas.report_tarea_template">
        
        <!-- Agregar días restantes ANTES de fecha límite -->
        <xpath expr="//p[strong='Fecha Límite:']" position="before">
            <p>
                <strong>Días Restantes:</strong> 
                <span t-field="o.dias_restantes"/>
            </p>
        </xpath>
    </template>
    
    <!-- Nueva acción de reporte -->
    <record id="action_report_tarea_con_dias" model="ir.actions.report">
        <field name="name">Imprimir Tarea (con Días)</field>
        <field name="model">mi.gestor.tareas.tarea</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mi_gestor_tareas.report_tarea_con_dias</field>
        <field name="report_file">mi_gestor_tareas.report_tarea_con_dias</field>
        <field name="binding_model_id" ref="model_mi_gestor_tareas_tarea"/>
        <field name="binding_type">report</field>
    </record>
</odoo>