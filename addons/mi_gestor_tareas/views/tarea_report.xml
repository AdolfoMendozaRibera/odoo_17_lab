<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_tarea_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1>Reporte de Tarea</h1>
                        <h2 t-field="o.name"/>
                        <p><strong>Estado:</strong> <span t-field="o.estado"/></p>
                        <p><strong>Fecha Límite:</strong> <span t-field="o.fecha_limite"/></p>
                        <p><strong>Prioridad:</strong> <span t-field="o.prioridad"/></p>
                    </div>
                </t>
            </t>
        </t>
    </template>
    
    <record id="action_report_tarea" model="ir.actions.report">
        <field name="name">Imprimir Tarea</field>
        <field name="model">mi.gestor.tareas.tarea</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mi_gestor_tareas.report_tarea_template</field>
        <field name="report_file">mi_gestor_tareas.report_tarea_template</field>
        <field name="binding_model_id" ref="model_mi_gestor_tareas_tarea"/>
        <field name="binding_type">report</field>
    </record>
</odoo>