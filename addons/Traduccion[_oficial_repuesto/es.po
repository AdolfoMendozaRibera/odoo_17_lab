#. module: oehealth
#: model:mail.template,body_html:oehealth.oeh_email_template_prescription
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    <!--            Dear {{ object.patient.name }},-->\n"
