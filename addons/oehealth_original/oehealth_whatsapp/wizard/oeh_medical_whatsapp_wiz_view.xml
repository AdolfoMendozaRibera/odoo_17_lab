<?xml version="1.0" ?>
<odoo>
    <data>

        <!-- Patient  WhatsApp Wizard view -->

        <record model="ir.ui.view" id="view_oeh_medical_whatsapp_wiz">
            <field name="name">Send WhatsApp</field>
            <field name="model">oeh.medical.whatsapp.wiz</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string='Send WhatsApp'>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="whatsapp_template_id"/>
                        <field name="mobile" invisible="1"/>
                    </group>
                    <group>
                        <field name="message" required="1"/>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <group>
                                <field name="attachment_ids" widget="many2many_binary" string="Send multiple files"
                                       nolabel="1" colspan="2"/>
                            </group>
                        </page>
                    </notebook>
                    <footer>
                        <button name="send_whatsapp_msg" string="Send WhatsApp" type="object"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>


