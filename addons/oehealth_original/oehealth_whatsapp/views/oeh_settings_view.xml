<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_oehealth" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.whatsappoehealth</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="oehealth.res_config_settings_view_form_oehealth"/>
        <field name="arch" type="xml">
            <block title="Appointment" name="oeh_appointment_setting_container" position="after">
                <block title="WhatsApp Integration" name="oeh_whatsapp_integration_setting_container">
                    <setting id="whatsapp_integration_conf">
                        <field name="enable_chat_api"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
