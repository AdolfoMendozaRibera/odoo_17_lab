<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ============================================ -->
        <!-- PERSONALIZACIÓN NOTA DE ENTREGA JAH -->
        <!-- ============================================ -->
        
        <template id="jah_report_delivery_document" inherit_id="stock.report_delivery_document">

            <!-- ========================================= -->
            <!-- SECCIÓN 1: PERSONALIZAR INFORMACIÓN DEL CLIENTE -->
            <!-- ========================================= -->
            
            <!-- Reemplazar el bloque de información -->
            <xpath expr="//div[@class='report-wrapping-flexbox clearfix row mt32 mb32']" position="replace">
                <div class="row mt-4 mb-2">
                    <div class="col-auto col-3 mw-100 mb-2">
                        <strong>Cliente:</strong><br/>
                        <span t-field="o.partner_id.name"/>
                    </div>
                    
                    <div t-if="o.partner_id.vat" class="col-auto col-3 mw-100 mb-2">
                        <strong>NIT:</strong><br/>
                        <span t-field="o.partner_id.vat"/>
                    </div>
                    
                    <div t-if="o.partner_id.street" class="col-auto col-3 mw-100 mb-2">
                        <strong>Dirección:</strong><br/>
                        <span t-field="o.partner_id.street"/>
                    </div>
                    
                    <div class="col-auto col-3 mw-100 mb-2">
                        <strong>Fecha:</strong><br/>
                        <span t-if="o.state == 'done'" t-field="o.date_done" t-options='{"widget": "date"}'/>
                        <span t-else="" t-field="o.scheduled_date" t-options='{"widget": "date"}'/>
                    </div>
                    
                    <div t-if="o.partner_id.ref" class="col-auto col-3 mw-100 mb-2">
                        <strong>Código Cliente:</strong><br/>
                        <span t-field="o.partner_id.ref"/>
                    </div>
                    
                    <div t-if="o.origin" class="col-auto col-3 mw-100 mb-2">
                        <strong>Documento Origen:</strong><br/>
                        <span t-field="o.origin"/>
                    </div>
                </div>
            </xpath>

            <!-- ========================================= -->
            <!-- SECCIÓN 2: REDISEÑAR TABLA DE PRODUCTOS (Estado != done) -->
            <!-- ========================================= -->
            
            <!-- Reemplazar tabla cuando el estado NO es 'done' -->
            <xpath expr="//table[@name='stock_move_table']" position="replace">
                <table class="table table-sm o_main_table mt-3" t-if="o.state!='done'" name="stock_move_table">
                    <thead>
                        <tr>
                            <th name="th_sm_product_code" class="text-start" style="width: 12%;">
                                <strong>Código</strong>
                            </th>
                            <th name="th_sm_product" class="text-start" style="width: 38%;">
                                <strong>Descripción</strong>
                            </th>
                            <th name="th_sm_uom" class="text-center" style="width: 12%;">
                                <strong>Unidad</strong>
                            </th>
                            <th name="th_sm_ordered" class="text-end" style="width: 12%;">
                                <strong>Ordenado</strong>
                            </th>
                            <th name="th_sm_quantity" class="text-end" style="width: 12%;">
                                <strong>Entregado</strong>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                        
                        <tr t-foreach="lines" t-as="move" t-key="move.id">
                            <!-- Código del Producto -->
                            <td name="td_sm_product_code">
                                <span t-field="move.product_id.default_code"/>
                            </td>
                            
                            <!-- Descripción -->
                            <td name="td_sm_product">
                                <span t-field="move.product_id.display_name"/>
                                <p t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name" style="font-size: 9pt; color: #666; margin: 0;">
                                    <span t-field="move.description_picking"/>
                                </p>
                            </td>
                            
                            <!-- Unidad de Medida -->
                            <td name="td_sm_uom" class="text-center">
                                <span t-field="move.product_uom"/>
                            </td>
                            
                            <!-- Cantidad Ordenada -->
                            <td name="td_sm_ordered" class="text-end">
                                <span t-field="move.product_uom_qty"/>
                            </td>
                            
                            <!-- Cantidad Entregada -->
                            <td name="td_sm_quantity" class="text-end">
                                <span t-field="move.quantity"/>
                            </td>
                        </tr>
                        
                        <!-- Fila si no hay movimientos -->
                        <tr t-if="not lines">
                            <td colspan="5" class="text-center text-muted">
                                <em>No hay productos para entregar</em>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </xpath>

            <!-- ========================================= -->
            <!-- SECCIÓN 3: MODIFICAR TABLA ESTADO 'DONE' -->
            <!-- ========================================= -->
            
            <!-- Agregar columna de Código en thead -->
            <xpath expr="//table[@name='stock_move_line_table']//th[@name='th_sml_product']" position="before">
                <th name="th_sml_product_code" class="text-start" style="width: 12%;">
                    <strong>Código</strong>
                </th>
            </xpath>
            
            <!-- Agregar columna de Unidad después de Ordered/Serial -->
            <xpath expr="//table[@name='stock_move_line_table']//th[@name='th_sml_qty_ordered']" position="after">
                <th name="th_sml_uom" class="text-center" style="width: 12%;">
                    <strong>Unidad</strong>
                </th>
            </xpath>
            
            <xpath expr="//table[@name='stock_move_line_table']//th[@name='lot_serial']" position="after">
                <th name="th_sml_uom_serial" class="text-center" style="width: 12%;">
                    <strong>Unidad</strong>
                </th>
            </xpath>

            <!-- ========================================= -->
            <!-- SECCIÓN 4: AGREGAR FIRMAS AL FINAL -->
            <!-- ========================================= -->
            
            <!-- Agregar firmas después del div de signature o antes del último oe_structure -->
            <xpath expr="//div[@name='signature']" position="after">
                <div class="row mt-5 pt-5" style="page-break-inside: avoid;">
                    <!-- Firma Responsable de Entrega -->
                    <div class="col-6">
                        <div style="border-top: 2px solid black; margin-top: 60px; text-align: center; padding-top: 10px;">
                            <p style="margin: 0; font-weight: bold;">
                                Responsable de Entrega
                            </p>
                            <p style="margin: 0; font-size: 9pt; color: #666;">
                                Nombre: _______________________________
                            </p>
                            <p style="margin: 0; font-size: 9pt; color: #666;">
                                CI: _______________
                            </p>
                        </div>
                    </div>
                    
                    <!-- Firma Cliente que Recibe -->
                    <div class="col-6">
                        <div style="border-top: 2px solid black; margin-top: 60px; text-align: center; padding-top: 10px;">
                            <p style="margin: 0; font-weight: bold;">
                                Cliente que Recibe
                            </p>
                            <p style="margin: 0; font-size: 9pt; color: #666;">
                                Nombre: _______________________________
                            </p>
                            <p style="margin: 0; font-size: 9pt; color: #666;">
                                CI: _______________
                            </p>
                        </div>
                    </div>
                </div>
            </xpath>
            
            <!-- También agregar firmas si NO hay signature (caso alternativo) -->
            <xpath expr="//div[@class='page']" position="inside">
                <t t-if="not o.signature">
                    <div class="row mt-5 pt-5" style="page-break-inside: avoid;">
                        <!-- Firma Responsable de Entrega -->
                        <div class="col-6">
                            <div style="border-top: 2px solid black; margin-top: 60px; text-align: center; padding-top: 10px;">
                                <p style="margin: 0; font-weight: bold;">
                                    Responsable de Entrega
                                </p>
                                <p style="margin: 0; font-size: 9pt; color: #666;">
                                    Nombre: _______________________________
                                </p>
                                <p style="margin: 0; font-size: 9pt; color: #666;">
                                    CI: _______________
                                </p>
                            </div>
                        </div>
                        
                        <!-- Firma Cliente que Recibe -->
                        <div class="col-6">
                            <div style="border-top: 2px solid black; margin-top: 60px; text-align: center; padding-top: 10px;">
                                <p style="margin: 0; font-weight: bold;">
                                    Cliente que Recibe
                                </p>
                                <p style="margin: 0; font-size: 9pt; color: #666;">
                                    Nombre: _______________________________
                                </p>
                                <p style="margin: 0; font-size: 9pt; color: #666;">
                                    CI: _______________
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </xpath>

        </template>

        <!-- ============================================ -->
        <!-- HEREDAR TEMPLATES PARA AGREGAR CÓDIGO Y UNIDAD -->
        <!-- ============================================ -->
        
        <!-- Template para líneas con número de serie -->
        <template id="jah_stock_report_delivery_has_serial_move_line" inherit_id="stock.stock_report_delivery_has_serial_move_line">
            <!-- Agregar código del producto al inicio -->
            <xpath expr="//td[1]" position="before">
                <td name="td_sml_code">
                    <span t-field="move_line.product_id.default_code"/>
                </td>
            </xpath>
            
            <!-- Agregar unidad después de lot/serial -->
            <xpath expr="//t[@name='move_line_lot']" position="after">
                <td class="text-center" name="td_sml_uom">
                    <span t-field="move_line.product_uom_id"/>
                </td>
            </xpath>
        </template>
        
        <!-- Template para líneas agregadas -->
        <template id="jah_stock_report_delivery_aggregated_move_lines" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
            <!-- Agregar código al inicio de cada fila -->
            <xpath expr="//tr//td[1]" position="before">
                <td name="td_aggregated_code">
                    <span t-esc="aggregated_lines[line].get('product', {}).get('default_code', '')"/>
                </td>
            </xpath>
            
            <!-- Agregar unidad después de qty_ordered -->
            <xpath expr="//td[@name='move_line_aggregated_qty_ordered']" position="after">
                <td class="text-center" name="td_aggregated_uom">
                    <!-- La unidad ya está incluida en qty_ordered, este td es para mantener consistencia -->
                </td>
            </xpath>
        </template>

        <!-- ============================================ -->
        <!-- REPORTE COMPLETO CON LAYOUT JAH -->
        <!-- ============================================ -->
        
        <template id="jah_report_picking" name="JAH Delivery Slip">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="jah_sale_documents.jah_external_layout">
                        <t t-call="jah_sale_documents.jah_report_delivery_document" t-lang="o._get_report_lang()"/>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============================================ -->
        <!-- REDEFINIR ACCIÓN DE REPORTE -->
        <!-- ============================================ -->
        
        <record id="stock.action_report_delivery" model="ir.actions.report">
            <field name="name">Nota de Entrega</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">jah_sale_documents.jah_report_picking</field>
            <field name="report_file">jah_sale_documents.jah_report_picking</field>
            <field name="print_report_name">'Nota de Entrega - %s' % (object.name)</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
            <field name="binding_type">report</field>
        </record>

    </data>
</odoo>