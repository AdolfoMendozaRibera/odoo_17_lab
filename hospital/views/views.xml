<odoo>
  <data>
      <!-- VISTA ARBOL -->
      <!-- Muestra las tareas en forma de lista-->

      <record id="view_paciente_tree" model="ir.ui.view">
        <field name="name">hospital.paciente.tree</field>
        <field name="model">hospital.paciente</field>
        <field name="arch" type="xml">
          <tree string="Lista de Pacientes">
            <field name="nombre"/>
            <field name="fecha_nacimiento"/>
            <field name="fecha_ingreso" placeholder="NA"/>
            <field name="genero"/>
          </tree>
      </record>


      <!-- VISTA FORMULARIO -->
      <!-- Formulario para crear/editar un paciente -->

      <record id="view_paciente_form" model="ir.ui.view">
        <field name="name">hospital.paciente.form</field>
        <field name="model">hospital.paciente</field>
        <field name="arch" type="xml">
          <form string="Paciente">
            <header>
              <p>Crea o edita los datos del paciente</p>
            </header>

            <sheet>
              <div>
                <h1>
                  <field name="nombre" placeholder="Nombre del Paciente"/>
                </h1>
              </div>

              <group>
                <group string="Datos del paciente">
                  <field name="fecha_nacimiento"/>
                  <field name="genero"/>
                </group>

                <group string="Informacion de Ingreso">
                    <field name="fecha_ingreso"/>
                </group>
              </group>

          </form>
      </record>



    <!-- ========== ACCIÓN DE VENTANA ========== -->
    <!-- Define cómo se abre el módulo -->

    <record model="ir.actions.act_window" id="hospital.action_window">
      <field name="name">hospital ventana</field>
      <field name="res_model">hospital.paciente</field>
      <field name="view_mode">tree,form</field>
      <field name="context">{}</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Crea tu primer paciente
        </p>
        <p>
          Haz clic en "Nuevo" para agregar un paciente.
        </p>
      </field>
    </record>

    
    <!-- Menú principal (raíz) -->
    <menuitem id="menu_hospital_paciente_root" 
              name="Hospital Paciente"
              sequence="10"/>
    
    <!-- Submenú -->
    <menuitem id="menu_pacientes" 
              name="Pacientes"
              parent="menu_hospital_paciente_root"
              action="hospital.action_window"
              sequence="10"/>


  </data>
</odoo>
